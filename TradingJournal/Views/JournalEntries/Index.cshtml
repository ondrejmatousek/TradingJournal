@model IEnumerable<TradingJournal.Models.JournalEntry>
@using TradingJournal.Models

@{
    ViewData["Title"] = "Journal";
}

<div class="container-fluid">
    <div class="mx-auto" style="max-width: 1200px;">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h2 class="mb-0">Journal</h2>
                <div class="text-muted small">Your trades</div>
            </div>
            <a asp-action="Create" class="btn btn-primary">+ New entry</a>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info">
                No entries yet. Click <strong>New entry</strong> to create your first trade.
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var item in Model)
                {
                    var entry = item.EntryTime.ToLocalTime();

                    // pokud máš ExitTime nullable, použij:
                    // DateTimeOffset? exit = item.ExitTime?.ToLocalTime();
                    // var durationText = exit.HasValue ? (exit.Value - entry).ToString(@"hh\:mm") : "—";
                    // a níže Exit zobraz přes (exit?.ToString(...) ?? "—")

                    var exit = item.ExitTime.ToLocalTime();
                    var durationText = (exit - entry).ToString(@"hh\:mm");

                    string outcomeClass = item.Outcome switch
                    {
                        TradeOutcome.Win => "bg-success",
                        TradeOutcome.Loss => "bg-danger",
                        TradeOutcome.Breakeven => "bg-secondary",
                        _ => "bg-light text-dark border"
                    };

                    <div class="card shadow-sm">
                        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="fw-semibold">@item.Asset</span>

                                <span class="badge @(item.Side == PositionSide.Long ? "bg-primary" : "bg-warning text-dark")">
                                    @item.Side
                                </span>

                                <span class="badge @outcomeClass">
                                    @item.Outcome
                                </span>

                                @if (item.FollowedTradingPlan)
                                {
                                    <span class="badge bg-info text-dark">Plan followed</span>
                                }
                            </div>

                            <div class="text-muted small">
                                Created: @item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </div>
                        </div>

                        <div class="card-body">
                            <div class="row g-3 align-items-center">
                                <!-- Levá část: metriky v řádcích, kompaktně -->
                                <div class="col-lg-7">
                                    <div class="row g-2">
                                        <div class="col-6 col-md-3">
                                            <div class="small text-muted">Entry</div>
                                            <div class="fw-semibold">@entry.ToString("dd.MM.yyyy HH:mm")</div>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <div class="small text-muted">Exit</div>
                                            <div class="fw-semibold">@exit.ToString("dd.MM.yyyy HH:mm")</div>
                                        </div>
                                        <div class="col-6 col-md-2">
                                            <div class="small text-muted">Risk</div>
                                            <div class="fw-semibold">@item.RiskPercentage.ToString("0.##") %</div>
                                        </div>
                                        <div class="col-6 col-md-2">
                                            <div class="small text-muted">Entry px</div>
                                            <div class="fw-semibold">@item.EntryPrice.ToString("0.########")</div>
                                        </div>
                                        <div class="col-6 col-md-2">
                                            <div class="small text-muted">Exit px</div>
                                            <div class="fw-semibold">@item.ExitPrice.ToString("0.########")</div>
                                        </div>
                                        <div class="col-6 col-md-2">
                                            <div class="small text-muted">Dur.</div>
                                            <div class="fw-semibold">@durationText</div>
                                        </div>
                                    </div>

                                    <div class="mt-3 d-flex gap-2">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">Details</a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">Delete</a>
                                    </div>
                                </div>

                                <!-- Pravá část: obrázek náhled -->
                                <div class="col-lg-5">
                                    @if (item.ImageData != null)
                                    {
                                        <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                                            <img src="@Url.Action("Image", "JournalEntries", new { id = item.Id })"
                                                 class="img-fluid rounded border"
                                                 style="max-height: 260px; width: 100%; object-fit: cover;" />
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="border rounded bg-light d-flex align-items-center justify-content-center"
                                             style="height: 260px;">
                                            <span class="text-muted">No image</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>