@model TradingJournal.ViewModels.HomeIndexViewModel
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = "EdgeDesk";
    ViewData["BodyClass"] = "marketing-shell";
}

<section class="hero-stage">
    <div class="hero-copy">
        <div class="home-command-card">
            <div class="home-command-brand">
                <span class="brand-mark">ED</span>
                <strong>EdgeDesk</strong>
            </div>

            <div class="home-command-actions">
                @if (SignInManager.IsSignedIn(User))
                {
                    <a asp-controller="JournalEntries" asp-action="Index" class="home-action primary">Journal</a>
                    <a asp-controller="JournalEntries" asp-action="Analysis" class="home-action">Analyza</a>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login" class="home-action primary">Sign in</a>
                    <a asp-area="Identity" asp-page="/Account/Register" class="home-action">Create account</a>
                }
            </div>

            <div class="home-mini-stats" aria-label="Quick overview">
                <div>
                    <span>Focus</span>
                    <strong>XAU / NQ / BTC</strong>
                </div>
                <div>
                    <span>Session</span>
                    <strong>Daily</strong>
                </div>
            </div>
        </div>
    </div>

    <div class="hero-visual">
        <div class="daily-opportunities-panel">
            <div class="daily-opportunities-head">
                <div>
                    <span>Prilezitosti dne</span>
                    <strong>Analyticky radar</strong>
                </div>
                <small id="dailyOpportunitiesUpdatedAt">loading</small>
            </div>

            <div class="widget-loading opportunities-loading" id="dailyOpportunitiesLoading" aria-label="Loading daily opportunities">
                <span></span>
                <span></span>
                <span></span>
            </div>
            <div class="daily-opportunities-list" id="dailyOpportunitiesList" hidden></div>
            <div class="daily-opportunities-empty" id="dailyOpportunitiesError" hidden>Prilezitosti se ted nepodarilo nacist.</div>

            <p class="daily-opportunities-note">
                Vyber vychazi z dostupnych analytickych targetu a valuace. Neni to investicni doporuceni.
            </p>
        </div>

        <div class="daily-bias-panel">
            <div class="daily-bias-head">
                <div>
                    <span>Market bias</span>
                    <strong>XAU &middot; NQ &middot; BTC</strong>
                </div>
                <small id="marketBiasUpdatedAt">loading</small>
                <form asp-controller="Home" asp-action="RefreshMarketBias" method="post" class="bias-refresh-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="bias-refresh-button" id="marketBiasRefresh">Refresh</button>
                </form>
            </div>

            <div class="widget-loading bias-loading" id="marketBiasLoading" aria-label="Loading market bias">
                <span></span>
                <span></span>
                <span></span>
            </div>
            <div class="bias-card-grid" id="marketBiasGrid" hidden></div>
            <div class="bias-empty" id="marketBiasError" hidden>Bias se ted nepodarilo nacist.</div>

            <div class="bias-disclaimer">
                Technicky kontext, ne financni doporuceni.
            </div>
        </div>

        <div class="home-insight-grid">
            <section class="home-insight-card market-regime-card" id="marketRegimeCard">
                <div class="home-insight-head">
                    <div>
                        <span>Market regime</span>
                        <strong id="marketRegimeTitle">loading</strong>
                    </div>
                    <em id="marketRegimeScore">0</em>
                </div>
                <p id="marketRegimeSummary">Nacitam kontext trhu...</p>
                <div class="regime-drivers" id="marketRegimeDrivers"></div>
            </section>

            <section class="home-insight-card macro-calendar-card">
                <div class="home-insight-head">
                    <div>
                        <span>Macro calendar</span>
                        <strong>Dnesni watch</strong>
                    </div>
                    <small id="macroCalendarUpdatedAt">loading</small>
                </div>
                <div class="macro-event-list" id="macroCalendarList">
                    <span class="insight-loading-line"></span>
                    <span class="insight-loading-line"></span>
                </div>
            </section>

            <section class="home-insight-card setup-watch-card">
                <div class="home-insight-head">
                    <div>
                        <span>Setup watchlist</span>
                        <strong>XAU / NQ / BTC</strong>
                    </div>
                    <small id="setupWatchUpdatedAt">loading</small>
                </div>
                <div class="setup-watch-list" id="setupWatchList">
                    <span class="insight-loading-line"></span>
                    <span class="insight-loading-line"></span>
                </div>
            </section>
        </div>

        <div class="stock-radar-panel">
            <div class="stock-radar-head">
                <div>
                    <span>Stock radar</span>
                    <strong>Undervalued watch</strong>
                </div>
                <small id="stockRadarUpdatedAt">loading</small>
            </div>

            <div class="widget-loading stock-loading" id="stockRadarLoading" aria-label="Loading stock radar">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
            </div>
            <div class="stock-idea-list" id="stockRadarList" hidden></div>
            <div class="stock-radar-empty" id="stockRadarError" hidden>Stock radar se ted nepodarilo nacist.</div>
        </div>

    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const endpoints = {
                marketBias: '@Url.Action("MarketBiasData", "Home")',
                refreshMarketBias: '@Url.Action("RefreshMarketBias", "Home")',
                stockRadar: '@Url.Action("StockRadarData", "Home")',
                marketRegime: '@Url.Action("MarketRegimeData", "Home")',
                macroCalendar: '@Url.Action("EconomicCalendarData", "Home")',
                setupWatchlist: '@Url.Action("SetupWatchlistData", "Home")'
            };

            const els = {
                biasGrid: document.getElementById('marketBiasGrid'),
                biasLoading: document.getElementById('marketBiasLoading'),
                biasError: document.getElementById('marketBiasError'),
                biasUpdatedAt: document.getElementById('marketBiasUpdatedAt'),
                biasRefresh: document.getElementById('marketBiasRefresh'),
                stockList: document.getElementById('stockRadarList'),
                stockLoading: document.getElementById('stockRadarLoading'),
                stockError: document.getElementById('stockRadarError'),
                stockUpdatedAt: document.getElementById('stockRadarUpdatedAt'),
                opportunitiesList: document.getElementById('dailyOpportunitiesList'),
                opportunitiesLoading: document.getElementById('dailyOpportunitiesLoading'),
                opportunitiesError: document.getElementById('dailyOpportunitiesError'),
                opportunitiesUpdatedAt: document.getElementById('dailyOpportunitiesUpdatedAt'),
                regimeCard: document.getElementById('marketRegimeCard'),
                regimeTitle: document.getElementById('marketRegimeTitle'),
                regimeScore: document.getElementById('marketRegimeScore'),
                regimeSummary: document.getElementById('marketRegimeSummary'),
                regimeDrivers: document.getElementById('marketRegimeDrivers'),
                macroUpdatedAt: document.getElementById('macroCalendarUpdatedAt'),
                macroList: document.getElementById('macroCalendarList'),
                setupUpdatedAt: document.getElementById('setupWatchUpdatedAt'),
                setupList: document.getElementById('setupWatchList')
            };

            const escapeHtml = (value) => String(value ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');

            const signedNumber = (value, digits = 0) => {
                if (value === null || value === undefined || Number.isNaN(Number(value))) {
                    return '';
                }

                const number = Number(value);
                return `${number > 0 ? '+' : ''}${number.toLocaleString('cs-CZ', {
                    minimumFractionDigits: digits,
                    maximumFractionDigits: digits
                })}`;
            };

            const compactNumber = (value, digits = 1) => {
                if (value === null || value === undefined || Number.isNaN(Number(value))) {
                    return '';
                }

                return Number(value).toLocaleString('cs-CZ', {
                    minimumFractionDigits: 0,
                    maximumFractionDigits: digits
                });
            };

            const renderStars = (count) => Array.from({ length: 5 }, (_, index) =>
                `<span class="${index < Number(count ?? 0) ? 'active' : ''}">&#9733;</span>`).join('');

            const setVisible = (element, visible) => {
                if (!element) return;
                element.hidden = !visible;
            };

            const renderMarketBias = (data) => {
                const items = Array.isArray(data.items) ? data.items : [];
                setVisible(els.biasLoading, false);
                els.biasUpdatedAt.textContent = data.updatedAt || 'offline';

                if (!items.length) {
                    els.biasError.textContent = data.message || 'Bias se ted nepodarilo nacist.';
                    setVisible(els.biasError, true);
                    setVisible(els.biasGrid, false);
                    return;
                }

                els.biasGrid.innerHTML = items.map((bias) => {
                    const direction = String(bias.direction || 'Neutral');
                    const directionClass = direction.toLowerCase();
                    const metrics = [
                        `<span>Score <strong>${signedNumber(bias.signalScore)}</strong></span>`,
                        bias.changePercent !== null && bias.changePercent !== undefined
                            ? `<span>Day <strong>${signedNumber(bias.changePercent, 2)}%</strong></span>`
                            : '',
                        bias.rsi14 !== null && bias.rsi14 !== undefined
                            ? `<span>RSI <strong>${compactNumber(bias.rsi14)}</strong></span>`
                            : ''
                    ].filter(Boolean).join('');

                    const bullet = Array.isArray(bias.bullets) && bias.bullets.length
                        ? `<span>${escapeHtml(bias.bullets[0])}</span>`
                        : '';

                    return `
                        <article class="bias-card ${escapeHtml(directionClass)}">
                            <button class="bias-card-button" type="button" aria-label="${escapeHtml(bias.symbol)} market bias">
                                <span class="bias-card-top">
                                    <span>
                                        <strong>${escapeHtml(bias.symbol)}</strong>
                                        <small>${escapeHtml(bias.displayName)}</small>
                                    </span>
                                    <em>${escapeHtml(direction)}</em>
                                </span>
                                <span class="bias-stars" aria-label="${escapeHtml(bias.confidenceStars)} stars">
                                    ${renderStars(bias.confidenceStars)}
                                </span>
                                <span class="bias-summary">${escapeHtml(bias.summary)}</span>
                                <span class="bias-metrics">${metrics}</span>
                                <span class="bias-bullets">${bullet}</span>
                            </button>
                        </article>`;
                }).join('');

                setVisible(els.biasError, false);
                setVisible(els.biasGrid, true);
            };

            const renderDailyOpportunities = (data) => {
                const items = Array.isArray(data.items) ? data.items : [];
                setVisible(els.opportunitiesLoading, false);
                els.opportunitiesUpdatedAt.textContent = data.updatedAt || 'offline';

                const opportunities = [...items]
                    .filter((idea) => idea && idea.symbol)
                    .sort((a, b) => {
                        const predictionDiff = (b.targetUpsidePercent ?? Number.NEGATIVE_INFINITY)
                            - (a.targetUpsidePercent ?? Number.NEGATIVE_INFINITY);

                        return predictionDiff !== 0
                            ? predictionDiff
                            : (b.score ?? 0) - (a.score ?? 0);
                    })
                    .slice(0, 3);

                if (!opportunities.length) {
                    els.opportunitiesError.textContent = data.message || 'Prilezitosti se ted nepodarilo nacist.';
                    setVisible(els.opportunitiesError, true);
                    setVisible(els.opportunitiesList, false);
                    return;
                }

                els.opportunitiesList.innerHTML = opportunities.map((idea) => {
                    const metrics = [
                        idea.targetUpsidePercent !== null && idea.targetUpsidePercent !== undefined
                            ? `<span>Predikce <strong>${signedNumber(idea.targetUpsidePercent, 1)}%</strong></span>`
                            : '',
                        idea.discountFromAthPercent !== null && idea.discountFromAthPercent !== undefined
                            ? `<span>Sleva od ATH <strong>-${compactNumber(idea.discountFromAthPercent, 1)}%</strong></span>`
                            : '',
                        idea.peRatio !== null && idea.peRatio !== undefined
                            ? `<span>P/E <strong>${compactNumber(idea.peRatio)}</strong></span>`
                            : ''
                    ].filter(Boolean).join('');

                    const reason = Array.isArray(idea.reasons) && idea.reasons.length
                        ? escapeHtml(idea.reasons[0])
                        : 'Akcie je ve watchlistu stock radaru.';

                    const analysisUrl = `https://finance.yahoo.com/quote/${encodeURIComponent(idea.symbol)}/analysis/`;

                    return `
                        <a class="daily-opportunity-card daily-opportunity-link" href="${analysisUrl}" target="_blank" rel="noopener noreferrer" title="Otevrit analyzu ${escapeHtml(idea.symbol || '')}">
                            <div class="daily-opportunity-title">
                                <strong>${escapeHtml(idea.symbol || '')}</strong>
                                <span>${escapeHtml(idea.name || '')}</span>
                            </div>
                            <em>${escapeHtml(String(idea.score ?? '-'))}/7</em>
                            <div class="daily-opportunity-metrics">${metrics}</div>
                            <p>${reason}</p>
                            <small>Analyza: Yahoo Finance / Alpha Vantage</small>
                        </a>`;
                }).join('');

                setVisible(els.opportunitiesError, false);
                setVisible(els.opportunitiesList, true);
            };

            const renderStockRadar = (data) => {
                const items = Array.isArray(data.items) ? data.items : [];
                setVisible(els.stockLoading, false);
                els.stockUpdatedAt.textContent = data.updatedAt || 'offline';
                renderDailyOpportunities(data);

                if (!items.length) {
                    els.stockError.textContent = data.message || 'Stock radar se ted nepodarilo nacist.';
                    setVisible(els.stockError, true);
                    setVisible(els.stockList, false);
                    return;
                }

                els.stockList.innerHTML = items.map((idea) => {
                    const metrics = [
                        idea.targetUpsidePercent !== null && idea.targetUpsidePercent !== undefined
                            ? `<span>Predikce <strong>${signedNumber(idea.targetUpsidePercent, 1)}%</strong></span>`
                            : '',
                        idea.discountFromAthPercent !== null && idea.discountFromAthPercent !== undefined
                            ? `<span>Sleva od ATH <strong>-${compactNumber(idea.discountFromAthPercent, 1)}%</strong></span>`
                            : '',
                        idea.peRatio !== null && idea.peRatio !== undefined
                            ? `<span>P/E <strong>${compactNumber(idea.peRatio)}</strong></span>`
                            : '',
                        idea.pegRatio !== null && idea.pegRatio !== undefined
                            ? `<span>PEG <strong>${compactNumber(idea.pegRatio, 2)}</strong></span>`
                            : ''
                    ].filter(Boolean).join('');

                    const reason = Array.isArray(idea.reasons) && idea.reasons.length
                        ? escapeHtml(idea.reasons[0])
                        : 'Akcie ma dostupna live fundamentalni data.';

                    return `
                        <article class="stock-idea">
                            <div>
                                <strong>${escapeHtml(idea.symbol)}</strong>
                                <span>${escapeHtml(idea.name)}</span>
                            </div>
                            <em>${escapeHtml(idea.score)}/7</em>
                            <div class="stock-idea-metrics">${metrics}</div>
                            <p>${reason}</p>
                        </article>`;
                }).join('');

                setVisible(els.stockError, false);
                setVisible(els.stockList, true);
            };

            const renderMarketRegime = (data) => {
                const tone = String(data.tone || 'neutral').toLowerCase();
                els.regimeCard.classList.remove('bullish', 'bearish', 'neutral');
                els.regimeCard.classList.add(tone);
                els.regimeTitle.textContent = data.regime || 'Mixed';
                els.regimeScore.textContent = signedNumber(data.score || 0);
                els.regimeSummary.textContent = data.summary || 'Trzni rezim se ted nepodarilo nacist.';
                els.regimeDrivers.innerHTML = (Array.isArray(data.drivers) ? data.drivers : [])
                    .map(driver => `<span>${escapeHtml(driver)}</span>`)
                    .join('');
            };

            const renderMacroCalendar = (data) => {
                const items = Array.isArray(data.items) ? data.items : [];
                els.macroUpdatedAt.textContent = data.updatedAt || 'offline';
                els.macroList.innerHTML = items.length
                    ? items.map(item => `
                        <article class="macro-event ${escapeHtml(String(item.impact || 'Medium').toLowerCase())}">
                            <time>${escapeHtml(item.time)}</time>
                            <div>
                                <strong>${escapeHtml(item.title)}</strong>
                                <small>${escapeHtml([item.currency, item.source].filter(Boolean).join(' · '))}</small>
                                <span>${escapeHtml(item.note)}</span>
                                <div class="macro-values">
                                    ${item.actual ? `<b>Actual ${escapeHtml(item.actual)}</b>` : ''}
                                    ${item.forecast ? `<b>Forecast ${escapeHtml(item.forecast)}</b>` : ''}
                                    ${item.previous ? `<b>Prev ${escapeHtml(item.previous)}</b>` : ''}
                                </div>
                            </div>
                            <em>${escapeHtml(item.impact)}</em>
                        </article>`).join('')
                    : `<div class="insight-empty">${escapeHtml(data.message || 'Dnes nejsou pripravene zadne watchpointy.')}</div>`;
            };

            const renderSetupWatchlist = (data) => {
                const items = Array.isArray(data.items) ? data.items : [];
                els.setupUpdatedAt.textContent = data.updatedAt || 'offline';
                els.setupList.innerHTML = items.length
                    ? items.map(item => `
                        <article class="setup-watch-item">
                            <div>
                                <strong>${escapeHtml(item.symbol)}</strong>
                                <em>${escapeHtml(item.bias)}</em>
                            </div>
                            <p>${escapeHtml(item.trigger)}</p>
                            <span>${escapeHtml(item.focus)}</span>
                        </article>`).join('')
                    : '<div class="insight-empty">Setup watchlist se ted nepodarilo nacist.</div>';
            };

            const loadMarketBias = async (forceRefresh = false) => {
                setVisible(els.biasLoading, true);
                setVisible(els.biasError, false);
                els.biasRefresh?.classList.add('is-loading');

                try {
                    const options = forceRefresh
                        ? {
                            method: 'POST',
                            headers: {
                                RequestVerificationToken: document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                            }
                        }
                        : {};

                    const response = await fetch(forceRefresh ? endpoints.refreshMarketBias : endpoints.marketBias, options);
                    if (!response.ok) {
                        throw new Error(`Market bias failed: ${response.status}`);
                    }

                    renderMarketBias(await response.json());
                } catch {
                    renderMarketBias({ items: [], message: 'Market bias se ted nepodarilo nacist.' });
                } finally {
                    els.biasRefresh?.classList.remove('is-loading');
                }
            };

            const loadStockRadar = async () => {
                setVisible(els.stockLoading, true);
                setVisible(els.stockError, false);
                setVisible(els.opportunitiesLoading, true);
                setVisible(els.opportunitiesError, false);
                setVisible(els.opportunitiesList, false);

                try {
                    const response = await fetch(endpoints.stockRadar);
                    if (!response.ok) {
                        throw new Error(`Stock radar failed: ${response.status}`);
                    }

                    renderStockRadar(await response.json());
                } catch {
                    renderStockRadar({ items: [], message: 'Stock radar se ted nepodarilo nacist.' });
                }
            };

            const loadMarketRegime = async () => {
                try {
                    const response = await fetch(endpoints.marketRegime);
                    if (!response.ok) {
                        throw new Error(`Market regime failed: ${response.status}`);
                    }

                    renderMarketRegime(await response.json());
                } catch {
                    renderMarketRegime({
                        regime: 'Mixed',
                        tone: 'neutral',
                        score: 0,
                        summary: 'Trzni rezim se ted nepodarilo nacist.',
                        drivers: []
                    });
                }
            };

            const loadMacroCalendar = async () => {
                try {
                    const response = await fetch(endpoints.macroCalendar);
                    if (!response.ok) {
                        throw new Error(`Macro calendar failed: ${response.status}`);
                    }

                    renderMacroCalendar(await response.json());
                } catch {
                    renderMacroCalendar({ items: [], updatedAt: 'offline' });
                }
            };

            const loadSetupWatchlist = async () => {
                try {
                    const response = await fetch(endpoints.setupWatchlist);
                    if (!response.ok) {
                        throw new Error(`Setup watchlist failed: ${response.status}`);
                    }

                    renderSetupWatchlist(await response.json());
                } catch {
                    renderSetupWatchlist({ items: [], updatedAt: 'offline' });
                }
            };

            els.biasRefresh?.addEventListener('click', (event) => {
                event.preventDefault();
                loadMarketBias(true);
            });

            loadMarketBias();
            loadStockRadar();
            loadMarketRegime();
            loadMacroCalendar();
            loadSetupWatchlist();
        })();
    </script>
}
