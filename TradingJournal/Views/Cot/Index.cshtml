@model TradingJournal.ViewModels.CotDashboardViewModel
@using System.Globalization
@using System.Text.Json

@{
    ViewData["Title"] = "COT Dashboard";
    ViewData["BodyClass"] = "journal-shell";
    var culture = new CultureInfo("cs-CZ");
    var markets = Model.Items.Select(item => new
    {
        key = item.SymbolKey,
        name = item.DisplayName,
        cotSymbol = item.CotSymbolKey,
        category = item.TraderCategory,
        latest = item.Latest is null ? null : new
        {
            date = item.Latest.ReportDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            bias = item.Latest.Bias,
            summary = item.Latest.Summary,
            net = item.Latest.NetPosition,
            weeklyChange = item.Latest.WeeklyNetChange,
            cotIndex = item.Latest.CotIndex52,
            openInterest = item.Latest.OpenInterest,
            isExtremeLong = item.Latest.ExtremeLong,
            isExtremeShort = item.Latest.ExtremeShort
        },
        isStale = item.IsStale,
        staleMessage = item.StaleMessage,
        narrative = new
        {
            headline = item.Narrative.Headline,
            overview = item.Narrative.Overview,
            bullishArguments = item.Narrative.BullishArguments,
            warningArguments = item.Narrative.WarningArguments,
            practicalUse = item.Narrative.PracticalUse
        },
        history = item.History.Select(point => new
        {
            date = point.ReportDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            nonCommercialLong = point.LongPosition,
            nonCommercialShort = point.ShortPosition,
            nonCommercialNet = point.NetPosition,
            cotIndex = point.CotIndex52,
            commercialsNet = point.CommercialsNetPosition,
            retailersNet = point.RetailersNetPosition
        })
    });
}

<div class="journal-page cot-page">
    <div class="journal-wrap cot-dashboard-wrap">
        <div class="cot-loading" role="status" aria-live="polite" hidden>
            <div class="cot-loading-head"></div>
            <div class="cot-loading-meta"></div>
            <div class="cot-loading-grid">
                <div class="cot-loading-card"><span></span><span></span><span></span><span></span></div>
                <div class="cot-loading-card"><span></span><span></span><span></span><span></span></div>
            </div>
            <p>Aktualizuji COT data...</p>
        </div>

        <header class="cot-dashboard-header">
            <div>
                <p class="cot-eyebrow">Weekly makro filtr</p>
                <h1>COT Dashboard</h1>
                <p>CFTC Commitments of Traders jako kontext pro weekly bias. COT není intradenní vstupní signál.</p>
            </div>
            <div class="cot-market-search">
                <input id="cot-market-search" type="search" value="@Model.Items.FirstOrDefault()?.DisplayName" autocomplete="off" spellcheck="false" aria-label="Vyhledat COT trh" aria-controls="cot-market-suggestions" aria-expanded="false">
                <div id="cot-market-suggestions" class="cot-market-suggestions" role="listbox" hidden></div>
                <span id="cot-market-status" class="cot-market-status" role="status"></span>
            </div>
            <form id="cot-update-form" asp-action="Update" method="post">
                @Html.AntiForgeryToken()
                <button class="btn btn-primary" type="submit">Aktualizovat COT data</button>
            </form>
        </header>

        @if (TempData["CotMessage"] is string message)
        {
            <div class="cot-notice">@message</div>
        }
        else if (!string.IsNullOrWhiteSpace(Model.LastImportMessage))
        {
            <div class="cot-notice">Poslední stav importu: @Model.LastImportMessage</div>
        }

        <div class="cot-meta">
            <span>Zdroj: CFTC Public Reporting Environment</span>
            <span>Aktualizace běží ručně tlačítkem a automaticky na pozadí podle služby</span>
            <span>Poslední úspěšná aktualizace: @(Model.LastSuccessfulImport?.ToLocalTime().ToString("dd.MM.yyyy HH:mm", culture) ?? "zatím žádná")</span>
        </div>

        <section class="cot-dashboard-summary" aria-label="COT přehled trhu">
            <div><span>Vybraný trh</span><strong id="cot-selected-market">-</strong></div>
            <div><span>Bias</span><strong id="cot-selected-bias">-</strong></div>
            <div><span>Report date</span><strong id="cot-selected-date">-</strong></div>
            <div><span>52W index</span><strong id="cot-selected-index">-</strong></div>
            <div><span>Net pozice</span><strong id="cot-selected-net">-</strong></div>
            <div><span>Open interest</span><strong id="cot-selected-oi">-</strong></div>
        </section>

        <section class="cot-dashboard-charts" aria-label="COT grafy vybraného trhu">
            <article class="cot-dashboard-chart" data-cot-panel="nonCommercials">
                <div class="cot-dashboard-chart-head">
                    <div><span class="cot-chart-title">Non-Commercials</span><span class="cot-chart-subtitle">Net pozice hlavní spekulativní skupiny + týdenní změny</span></div>
                    <span class="cot-chart-chip">Non-commercial net</span>
                </div>
                <div class="cot-chart-stage"><canvas class="cot-chart-canvas"></canvas><div class="cot-chart-tooltip" hidden></div></div>
                <div class="cot-chart-dates"><span></span><span></span></div>
            </article>

            <article class="cot-dashboard-chart" data-cot-panel="commercials">
                <div class="cot-dashboard-chart-head">
                    <div><span class="cot-chart-title">Commercials</span><span class="cot-chart-subtitle">Net pozice hedgerů + týdenní změny</span></div>
                    <span class="cot-chart-chip is-commercial">Commercial net</span>
                </div>
                <div class="cot-chart-stage"><canvas class="cot-chart-canvas"></canvas><div class="cot-chart-tooltip" hidden></div></div>
                <div class="cot-chart-dates"><span></span><span></span></div>
            </article>

            <article class="cot-dashboard-chart" data-cot-panel="netPositions">
                <div class="cot-dashboard-chart-head">
                    <div><span class="cot-chart-title">Net Pozice</span><span class="cot-chart-subtitle">Srovnání non-commercials, commercials a retail/non-reportable</span></div>
                    <div class="cot-panel-legend"><span><i class="cot-legend-noncommercial"></i>Non-commercials</span><span><i class="cot-legend-commercials"></i>Commercials</span><span><i class="cot-legend-retailers"></i>Retailers</span></div>
                </div>
                <div class="cot-chart-stage"><canvas class="cot-chart-canvas"></canvas><div class="cot-chart-tooltip" hidden></div></div>
                <div class="cot-chart-dates"><span></span><span></span></div>
            </article>

            <article class="cot-dashboard-chart" data-cot-panel="index">
                <div class="cot-dashboard-chart-head">
                    <div><span class="cot-chart-title">COT Index</span><span class="cot-chart-subtitle">52týdenní index non-commercials a commercials, extrémy 20/80</span></div>
                    <div class="cot-panel-legend"><span><i class="cot-legend-index"></i>Non-commercials</span><span><i class="cot-legend-commercial-index"></i>Commercials</span></div>
                </div>
                <div class="cot-chart-stage"><canvas class="cot-chart-canvas"></canvas><div class="cot-chart-tooltip" hidden></div></div>
                <div class="cot-chart-dates"><span></span><span></span></div>
            </article>
        </section>

        <section class="cot-narrative cot-dashboard-narrative" aria-label="Automatické COT shrnutí">
            <div class="cot-narrative-head">
                <span class="cot-narrative-kicker">Automatický komentář</span>
                <h3 id="cot-narrative-headline">-</h3>
            </div>
            <p id="cot-narrative-overview" class="cot-narrative-overview"></p>
            <div class="cot-narrative-columns">
                <div><strong>Bullish argumenty</strong><ul id="cot-bullish-arguments"></ul></div>
                <div><strong>Varování / rozpory</strong><ul id="cot-warning-arguments"></ul></div>
            </div>
            <div class="cot-narrative-practical">
                <strong>Praktické použití</strong>
                <p id="cot-practical-use"></p>
            </div>
        </section>

        <p id="cot-market-summary" class="cot-summary"></p>
    </div>
</div>

<script id="cot-dashboard-data" type="application/json">@Html.Raw(JsonSerializer.Serialize(markets))</script>
