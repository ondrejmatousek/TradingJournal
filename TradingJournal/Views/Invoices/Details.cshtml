@model TradingJournal.Models.Invoice
@using TradingJournal.Models

@{
    var variableSymbol = VariableSymbol(Model.InvoiceNumber);
    ViewData["Title"] = variableSymbol;
    ViewData["BodyClass"] = "journal-shell";
}

<div class="journal-page">
    <div class="journal-wrap">
        <div class="journal-header">
            <div>
                <div class="eyebrow">Invoice detail</div>
                <h1>@variableSymbol</h1>
                <p>@Model.CustomerCompany?.Name · @Model.IssueDate.ToString("dd.MM.yyyy")</p>
            </div>
            <div class="page-actions">
                <a asp-action="Index" class="btn btn-outline-secondary">Zpět</a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Upravit</a>
                <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-secondary">PDF / tisk</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Smazat</a>
                <a asp-action="Create" class="btn btn-primary">Nová faktura</a>
            </div>
        </div>

        <div class="detail-grid invoice-detail-grid">
            <section class="app-card trade-summary">
                <div class="invoice-detail-head">
                    <div>
                        <span class="muted small">Dodavatel</span>
                        <h2>@Model.SupplierCompany?.Name</h2>
                        <p>@Model.SupplierCompany?.Street, @Model.SupplierCompany?.ZipCode @Model.SupplierCompany?.City</p>
                        <p>
                            IČO @Model.SupplierCompany?.RegistrationNumber
                            @if (Model.SupplierCompany?.IsVatPayer == true && !string.IsNullOrWhiteSpace(Model.SupplierCompany.TaxNumber))
                            {
                                <span> · DIČ @Model.SupplierCompany.TaxNumber</span>
                            }
                        </p>
                    </div>
                    <div>
                        <span class="muted small">Odběratel</span>
                        <h2>@Model.CustomerCompany?.Name</h2>
                        <p>@Model.CustomerCompany?.Street, @Model.CustomerCompany?.ZipCode @Model.CustomerCompany?.City</p>
                        <p>
                            IČO @Model.CustomerCompany?.RegistrationNumber
                            @if (Model.CustomerCompany?.IsVatPayer == true && !string.IsNullOrWhiteSpace(Model.CustomerCompany.TaxNumber))
                            {
                                <span> · DIČ @Model.CustomerCompany.TaxNumber</span>
                            }
                        </p>
                    </div>
                </div>

                <div class="metric-grid">
                    <div class="metric-cell">
                        <span>Datum vystavení</span>
                        <strong>@Model.IssueDate.ToString("dd.MM.yyyy")</strong>
                    </div>
                    <div class="metric-cell">
                        <span>Splatnost</span>
                        <strong>@Model.DueDate.ToString("dd.MM.yyyy")</strong>
                    </div>
                    <div class="metric-cell">
                        <span>Zdanitelné plnění</span>
                        <strong>@(Model.TaxableSupplyDate?.ToString("dd.MM.yyyy") ?? "-")</strong>
                    </div>
                </div>

                <div class="invoice-items">
                    <div class="invoice-items-head">
                        <span>Popis</span>
                        <span>Množství</span>
                        <span>Cena</span>
                        <span>DPH</span>
                        <span>Celkem</span>
                    </div>
                    @foreach (var item in Model.Items)
                    {
                        <div class="invoice-item-row">
                            <span>@item.Description</span>
                            <span>@item.Quantity.ToString("N2") @item.Unit</span>
                            <span>@item.UnitPrice.ToString("N2")</span>
                            <span>@item.VatRate.ToString("N0")%</span>
                            <strong>@item.TotalGross.ToString("N2")</strong>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="journal-note">
                        <span>Poznámka</span>
                        <div class="preline">@Model.Notes</div>
                    </div>
                }
            </section>

            <aside class="app-card screenshot-panel">
                <div class="panel-title">
                    <span>Souhrn</span>
                    <strong>@Model.Currency</strong>
                </div>
                <div class="invoice-summary-lines">
                    <div><span>Základ</span><strong>@Model.TotalNet.ToString("N2")</strong></div>
                    <div><span>DPH</span><strong>@Model.TotalVat.ToString("N2")</strong></div>
                    <div class="total"><span>Celkem</span><strong>@Model.TotalGross.ToString("N2")</strong></div>
                </div>
                <div class="journal-note compact">
                    <span>Bankovní účet</span>
                    <div>@(Model.SupplierCompany?.BankAccount ?? Model.SupplierCompany?.Iban ?? "-")</div>
                </div>
            </aside>
        </div>
    </div>
</div>

@functions {
    private static string VariableSymbol(string? invoiceNumber)
    {
        var digits = new string((invoiceNumber ?? string.Empty).Where(char.IsDigit).ToArray());
        return string.IsNullOrWhiteSpace(digits) ? invoiceNumber ?? string.Empty : digits;
    }
}
