@model TradingJournal.Models.JournalEntry
@using TradingJournal.Models

@{
    ViewData["Title"] = "Edit journal entry";
    ViewData["BodyClass"] = "journal-shell";
}

<div class="journal-page">
<div class="container-lg">
    <div class="row justify-content-center">
        <div class="col-xl-9 col-lg-10">
            <div class="journal-header compact">
                <div>
                    <div class="eyebrow">Trade review</div>
                    <h1>Edit journal entry</h1>
                    <p>Refine the trade record and keep the review accurate.</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
            </div>

            <div class="app-card form-card">
                <div class="card-body">
                    <form asp-action="Edit" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="Id" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Asset" class="form-label"></label>
                                <select asp-for="Asset" asp-items="Html.GetEnumSelectList<AssetSymbol>()" class="form-select"></select>
                                <span asp-validation-for="Asset" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Side" class="form-label"></label>
                                <select asp-for="Side" asp-items="Html.GetEnumSelectList<PositionSide>()" class="form-select"></select>
                                <span asp-validation-for="Side" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label">Trade status</label>
                                <select asp-for="Status" asp-items="Html.GetEnumSelectList<EntryStatus>()" class="form-select" id="tradeStatus"></select>
                                <div class="form-text">Use Open for a trade that is still running.</div>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EntryTime" class="form-label">Entry time</label>
                                <input asp-for="EntryTime" type="datetime-local" class="form-control"
                                       value="@(Model.EntryTime.HasValue? Model.EntryTime.Value.ToLocalTime().ToString("yyyy-MM-ddTHH:mm") : "")" />
                                <span asp-validation-for="EntryTime" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 trade-closed-field">
                                <label asp-for="ExitTime" class="form-label">Exit time</label>
                                <input asp-for="ExitTime" type="datetime-local" class="form-control"
                                       value="@(Model.ExitTime.HasValue? Model.ExitTime.Value.ToLocalTime().ToString("yyyy-MM-ddTHH:mm") : "")" />
                                <span asp-validation-for="ExitTime" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="RiskPercentage" class="form-label">Risk (%)</label>
                                <input asp-for="RiskPercentage" class="form-control" inputmode="decimal" />
                                <span asp-validation-for="RiskPercentage" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="EntryPrice" class="form-label">Entry price</label>
                                <input asp-for="EntryPrice" class="form-control" inputmode="decimal" />
                                <span asp-validation-for="EntryPrice" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 trade-closed-field">
                                <label asp-for="ExitPrice" class="form-label">Exit price</label>
                                <input asp-for="ExitPrice" class="form-control" inputmode="decimal" />
                                <span asp-validation-for="ExitPrice" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 trade-closed-field">
                                <label asp-for="Outcome" class="form-label"></label>
                                <select asp-for="Outcome" asp-items="Html.GetEnumSelectList<TradeOutcome>()" class="form-select"></select>
                                <span asp-validation-for="Outcome" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 d-flex align-items-end">
                                <div class="form-check">
                                    <input class="form-check-input" asp-for="FollowedTradingPlan" />
                                    <label class="form-check-label" asp-for="FollowedTradingPlan">
                                        Followed trading plan
                                    </label>
                                </div>
                            </div>

                            <div class="col-12">
                                <label asp-for="Note" class="form-label">Note</label>
                                <textarea asp-for="Note" class="form-control journal-textarea" rows="8"
                                          placeholder="Why did you enter? What was the plan? What happened during execution?"></textarea>
                                <span asp-validation-for="Note" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="FeelingsBeforeEntry" class="form-label">Feelings before entry</label>
                                <textarea asp-for="FeelingsBeforeEntry" class="form-control journal-textarea" rows="5"
                                          placeholder="Confidence, hesitation, urgency, fear, patience..."></textarea>
                                <span asp-validation-for="FeelingsBeforeEntry" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Screenshots</label>

                                @if (Model.Images.Any() || Model.ImageData != null)
                                {
                                    <div class="image-gallery mb-3">
                                        @foreach (var image in Model.Images.OrderBy(i => i.CreatedAt))
                                        {
                                            <button type="button" class="image-modal-trigger" data-image-src="@Url.Action("GalleryImage", "JournalEntries", new { id = image.Id })" data-image-title="@Model.Asset screenshot">
                                                <img src="@Url.Action("GalleryImage", "JournalEntries", new { id = image.Id })"
                                                     class="form-image-preview" />
                                            </button>
                                        }
                                        @if (Model.ImageData != null)
                                        {
                                            <button type="button" class="image-modal-trigger" data-image-src="@Url.Action("Image", "JournalEntries", new { id = Model.Id })" data-image-title="@Model.Asset screenshot">
                                                <img src="@Url.Action("Image", "JournalEntries", new { id = Model.Id })"
                                                     class="form-image-preview" />
                                            </button>
                                        }
                                    </div>

                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" name="removeImage" value="true" id="removeImage">
                                        <label class="form-check-label" for="removeImage">
                                            Remove existing image
                                        </label>
                                    </div>
                                }

                                <input type="file" name="imageFiles" class="form-control" accept="image/*" multiple />
                                <div class="form-text">New uploads are added to the gallery. You can upload up to 8 images at once.</div>
                            </div>
                        </div>

                        <div class="mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Save changes</button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-muted small mt-2">
                Created: @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
            </div>
        </div>
    </div>
</div>
</div>

<partial name="_ImagePreviewModal" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (() => {
            const status = document.getElementById('tradeStatus');
            const closedFields = document.querySelectorAll('.trade-closed-field');

            function syncTradeStatus() {
                const isOpen = status?.value === '@((int)EntryStatus.Open)' || status?.selectedOptions?.[0]?.text === 'Open';
                closedFields.forEach(field => {
                    field.classList.toggle('d-none', isOpen);
                    field.querySelectorAll('input, select').forEach(input => {
                        input.disabled = isOpen;
                    });
                });
            }

            status?.addEventListener('change', syncTradeStatus);
            syncTradeStatus();
        })();
    </script>
    <script src="~/js/journal-ui.js" asp-append-version="true"></script>
}
