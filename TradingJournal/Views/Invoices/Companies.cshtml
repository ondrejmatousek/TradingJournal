@model List<TradingJournal.Models.InvoiceCompany>

@{
    ViewData["Title"] = "Firmy";
    ViewData["BodyClass"] = "journal-shell";
}

<div class="journal-page">
    <div class="journal-wrap">
        <div class="journal-header">
            <div>
                <div class="eyebrow">Billing contacts</div>
                <h1>Firmy</h1>
                <p>Dodavatelé a odběratelé pro fakturaci.</p>
            </div>
            <div class="page-actions">
                <a asp-action="CreateCompany" class="btn btn-primary">Nová firma</a>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info">Zatím nemáš uloženou žádnou firmu. Vytvoř svoji firmu a potom firmu klienta.</div>
        }
        else
        {
            <div class="company-grid">
                @foreach (var company in Model)
                {
                    <div class="app-card company-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between gap-3 align-items-start">
                                <div>
                                    <h2>@company.Name</h2>
                                    <p>@company.Street, @company.ZipCode @company.City</p>
                                </div>
                                @if (company.IsDefaultSupplier)
                                {
                                    <span class="badge badge-side">Výchozí dodavatel</span>
                                }
                            </div>

                            <div class="company-meta">
                                <span>IČO @(company.RegistrationNumber ?? "-")</span>
                                <span>@(company.IsVatPayer ? $"DIČ {company.TaxNumber ?? "-"}" : "Neplátce DPH")</span>
                                <span>@(company.Email ?? "-")</span>
                                <span>@(company.BankAccount ?? company.Iban ?? "-")</span>
                                <span>Poslední sazba @(company.LastHourlyRate?.ToString("N2") ?? "-")</span>
                            </div>

                            <div class="company-actions">
                                <a asp-action="EditCompany" asp-route-id="@company.Id" class="btn btn-primary btn-sm">Editovat</a>
                                <a asp-action="DeleteCompany" asp-route-id="@company.Id" class="btn btn-outline-danger btn-sm">Smazat</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
