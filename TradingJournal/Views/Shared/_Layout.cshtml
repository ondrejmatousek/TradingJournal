@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    var bodyClass = ViewData["BodyClass"] as string ?? string.Empty;
    var isFullBleed = bodyClass.Contains("marketing-shell") || bodyClass.Contains("auth-shell") || bodyClass.Contains("journal-shell");
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var isTradingSection = controller == "JournalEntries" || controller == "Cot" || controller == "Seasonality";
    var isProgrammingSection = controller == "Invoices";
    var isInvestmentSection = controller == "Investments" || controller == "Screening";
    var showSidebar = SignInManager.IsSignedIn(User) && !bodyClass.Contains("marketing-shell") && !bodyClass.Contains("auth-shell") && (isTradingSection || isProgrammingSection || isInvestmentSection);
}

<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EdgeDesk</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TradingJournal.styles.css" asp-append-version="true" />
</head>
<body class="@($"{bodyClass} {(showSidebar ? "app-section-shell" : string.Empty)}".Trim())">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm app-navbar">
            <div class="container-fluid">
                <a class="navbar-brand app-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">ED</span>
                    <span>EdgeDesk</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(isTradingSection ? "active" : "")" asp-controller="JournalEntries" asp-action="Index">Trading</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isInvestmentSection ? "active" : "")" asp-controller="Screening" asp-action="Index">Investování</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isProgrammingSection ? "active" : "")" asp-controller="Invoices" asp-action="Index">Programování</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="@(showSidebar ? "app-workspace" : isFullBleed ? "app-fullbleed" : "container")">
        @if (showSidebar)
        {
            <aside class="app-sidebar">
                @if (isTradingSection)
                {
                    <div class="sidebar-title">Trading</div>
                    <a class="sidebar-link @(controller == "JournalEntries" && action == "Index" ? "active" : "")" asp-controller="JournalEntries" asp-action="Index">Journal</a>
                    <a class="sidebar-link @(controller == "JournalEntries" && action == "Strategy" ? "active" : "")" asp-controller="JournalEntries" asp-action="Strategy">Strategie</a>
                    <a class="sidebar-link @(controller == "JournalEntries" && action == "SetupReview" ? "active" : "")" asp-controller="JournalEntries" asp-action="SetupReview">Setup Review</a>
                    <a class="sidebar-link @(controller == "Cot" ? "active" : "")" asp-controller="Cot" asp-action="Index">COT Dashboard</a>
                    <a class="sidebar-link @(controller == "Seasonality" ? "active" : "")" asp-controller="Seasonality" asp-action="Index">Seasonality</a>
                    <a class="sidebar-link @(controller == "JournalEntries" && action == "TradeQuality" ? "active" : "")" asp-controller="JournalEntries" asp-action="TradeQuality">Kvalita tradu</a>
                    <a class="sidebar-link @(controller == "JournalEntries" && action == "Analysis" ? "active" : "")" asp-controller="JournalEntries" asp-action="Analysis">Analýza</a>
                }
                else if (isProgrammingSection)
                {
                    var isCompanyAction = action.Contains("Company") || action == "Companies";
                    <div class="sidebar-title">Programování</div>
                    <a class="sidebar-link @(!isCompanyAction ? "active" : "")" asp-controller="Invoices" asp-action="Index">Fakturace</a>
                    <a class="sidebar-link @(isCompanyAction ? "active" : "")" asp-controller="Invoices" asp-action="Companies">Firmy</a>
                }
                else if (isInvestmentSection)
                {
                    <div class="sidebar-title">Investování</div>
                    <a class="sidebar-link @(action == "Planner" ? "active" : "")" asp-controller="Investments" asp-action="Planner">Investiční plánovač</a>
                    <a class="sidebar-link @(controller == "Screening" ? "active" : "")" asp-controller="Screening" asp-action="Index">Akciový screener</a>
                }
            </aside>
        }
        <main role="main" class="@(showSidebar ? "app-workspace-main" : "pb-3")">
                @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted @((isFullBleed || showSidebar) ? "d-none" : "border-top")">
        <div class="container">
            &copy; 2026 - EdgeDesk - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/cot-chart.js" asp-append-version="true"></script>
    <script src="~/js/cot-page-refresh.js" asp-append-version="true"></script>
    <script src="~/js/seasonality-geometry.js" asp-append-version="true"></script>
    <script src="~/js/seasonality.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
