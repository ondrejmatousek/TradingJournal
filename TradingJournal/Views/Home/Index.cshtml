@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = "EdgeDesk";
    ViewData["BodyClass"] = "marketing-shell";
}

<section class="home-welcome" aria-labelledby="home-title">
    <div class="home-welcome-card">
        <div class="home-command-brand">
            <span class="brand-mark">ED</span>
            <strong>EdgeDesk</strong>
        </div>
        <h1 id="home-title">Trading Journal a investiční výzkum</h1>
        <p>
            Jedno místo pro obchodní deník, analýzu trhu a screening akcií.
            Přihlaste se a pokračujte do aplikace.
        </p>
        <div class="home-command-actions">
            @if (SignInManager.IsSignedIn(User))
            {
                <a asp-controller="Screening" asp-action="Index" class="home-action primary">Otevřít aplikaci</a>
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Login" class="home-action primary">Přihlásit se</a>
                <a asp-area="Identity" asp-page="/Account/Register" class="home-action">Vytvořit účet</a>
            }
        </div>
    </div>
</section>
