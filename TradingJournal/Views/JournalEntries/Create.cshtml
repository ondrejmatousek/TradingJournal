@model TradingJournal.Models.JournalEntry
@using TradingJournal.Models

@{
    ViewData["Title"] = "New journal entry";
}

<div class="container-lg">
    <div class="row justify-content-center">
        <div class="col-xl-9 col-lg-10">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 class="mb-0">New journal entry</h2>
                <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Create" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Asset" class="form-label"></label>
                                <select asp-for="Asset" asp-items="Html.GetEnumSelectList<AssetSymbol>()" class="form-select"></select>
                                <span asp-validation-for="Asset" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Side" class="form-label"></label>
                                <select asp-for="Side" asp-items="Html.GetEnumSelectList<PositionSide>()" class="form-select"></select>
                                <span asp-validation-for="Side" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EntryTime" class="form-label">Entry time</label>
                                <input asp-for="EntryTime"
                                       type="datetime-local"
                                       class="form-control"
                                       value="@(Model.EntryTime.HasValue
                                                      ? Model.EntryTime.Value.LocalDateTime.ToString("yyyy-MM-ddTHH:mm")
                                                      : "")" />
                                <div class="form-text">Pick date and time of entry.</div>
                                <span asp-validation-for="EntryTime" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ExitTime" class="form-label">Exit time</label>
                                <input asp-for="ExitTime"
                                       type="datetime-local"
                                       class="form-control"
                                       value="@(Model.ExitTime.HasValue
                                                      ? Model.ExitTime.Value.LocalDateTime.ToString("yyyy-MM-ddTHH:mm")
                                                      : "")" />
                                <div class="form-text">Leave empty if trade is not closed yet.</div>
                                <span asp-validation-for="ExitTime" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="RiskPercentage" class="form-label">Risk (%)</label>
                                <input asp-for="RiskPercentage" class="form-control" inputmode="decimal" placeholder="e.g. 1.0" />
                                <span asp-validation-for="RiskPercentage" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="EntryPrice" class="form-label">Entry price</label>
                                <input asp-for="EntryPrice" class="form-control" inputmode="decimal" placeholder="e.g. 2034.50" />
                                <span asp-validation-for="EntryPrice" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="ExitPrice" class="form-label">Exit price</label>
                                <input asp-for="ExitPrice" class="form-control" inputmode="decimal" placeholder="e.g. 2040.00" />
                                <span asp-validation-for="ExitPrice" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Outcome" class="form-label"></label>
                                <select asp-for="Outcome" asp-items="Html.GetEnumSelectList<TradeOutcome>()" class="form-select"></select>
                                <span asp-validation-for="Outcome" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 d-flex align-items-end">
                                <div class="form-check">
                                    <input class="form-check-input" asp-for="FollowedTradingPlan" />
                                    <label class="form-check-label" asp-for="FollowedTradingPlan">
                                        Followed trading plan
                                    </label>
                                </div>
                            </div>

                            <div class="col-12">
                                <label asp-for="Note" class="form-label">Note</label>
                                <textarea asp-for="Note" class="form-control wysiwyg" rows="10"></textarea>
                                <span asp-validation-for="Note" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="FeelingsBeforeEntry" class="form-label">Feelings before entry</label>
                                <textarea asp-for="FeelingsBeforeEntry" class="form-control wysiwyg" rows="6"></textarea>
                                <span asp-validation-for="FeelingsBeforeEntry" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Screenshot</label>
                                <input type="file" name="imageFile" class="form-control" accept="image/*" />
                                <div class="form-text">Optional. PNG/JPG recommended.</div>
                            </div>
                        </div>

                        <div class="mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Save</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.tiny.cloud/1/1sbhgdu0fa3a6yihwurdgvqe6go3urepo6t3b5h0o1st0lc8/tinymce/8/tinymce.min.js"
            referrerpolicy="origin" crossorigin="anonymous"></script>

    <script>
        tinymce.init({
            selector: 'textarea.wysiwyg',
            height: 300,
            menubar: true,
            plugins: [
                'anchor', 'autolink', 'charmap', 'codesample', 'emoticons',
                'link', 'lists', 'searchreplace', 'table', 'visualblocks', 'wordcount'
            ],
            toolbar: 'undo redo | blocks | bold italic underline strikethrough | bullist numlist | link table | emoticons charmap | removeformat',
            branding: false,
            promotion: false
        });
    </script>
}