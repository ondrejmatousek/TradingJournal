@{
    ViewData["Title"] = "Pod 200 EMA";
    ViewData["BodyClass"] = "journal-shell";
}

<div class="journal-page investment-page">
    <div class="investment-wrap">
        <div class="journal-header investment-header">
            <div>
                <div class="eyebrow">Investment radar</div>
                <h1>Pod 200 EMA</h1>
                <p>Weekly screening firem, ktere jsou dlouhodobe v rustove fazi, ale aktualni cena je pod weekly EMA200.</p>
            </div>
            <div class="page-actions">
                <button type="button" class="btn btn-primary" id="emaRefresh">Refresh</button>
            </div>
        </div>

        <section class="investment-summary app-card">
            <div>
                <span>Nalezeno</span>
                <strong id="emaCount">-</strong>
                <small>tickeru v seznamu</small>
            </div>
            <div>
                <span>Prumerna sleva</span>
                <strong id="emaAvgDiscount">-</strong>
                <small>vuci weekly EMA200</small>
            </div>
            <div>
                <span>Zdroj</span>
                <strong>Alpha / Stooq</strong>
                <small id="emaUpdatedAt">nacitam</small>
            </div>
            <div>
                <span>Filtr</span>
                <strong>Trend + pullback</strong>
                <small>jen cena pod rostouci EMA200</small>
            </div>
        </section>

        <section class="investment-toolbar app-card">
            <div>
                <label for="emaSearch">Hledat</label>
                <input id="emaSearch" class="form-control" type="search" placeholder="Ticker nebo firma" autocomplete="off" />
            </div>
            <div>
                <label for="emaSector">Sektor</label>
                <select id="emaSector" class="form-select">
                    <option value="">Vsechny sektory</option>
                </select>
            </div>
            <p id="emaMessage">Nacitam screening...</p>
        </section>

        <section class="investment-loading app-card" id="emaLoading" aria-label="Nacitam screening">
            <span></span>
            <span></span>
            <span></span>
        </section>

        <section class="investment-grid" id="emaCards" hidden></section>

        <section class="investment-empty app-card" id="emaEmpty" hidden>
            <h2>Zatim nic ve filtru</h2>
            <p>Bud data nejsou dostupna, nebo zadna firma z watchlistu aktualne neni pod rostouci weekly EMA200.</p>
        </section>

        <section class="investment-table app-card" id="emaTableWrap" hidden>
            <div class="panel-title">
                <span>Detail screeningu</span>
                <strong id="emaTableCount">0 firem</strong>
            </div>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>Ticker</th>
                            <th>Firma</th>
                            <th>Cena</th>
                            <th>Weekly EMA200</th>
                            <th>Pod EMA</th>
                            <th>EMA 52w</th>
                            <th>5 let</th>
                            <th>Skore</th>
                        </tr>
                    </thead>
                    <tbody id="emaRows"></tbody>
                </table>
            </div>
        </section>

        <p class="investment-disclaimer">Technicky screening pro watchlist. Neni to investicni doporuceni ani signal k nakupu.</p>
    </div>
</div>

<style>
    .investment-page {
        padding: clamp(1.1rem, 2vw, 2rem);
    }

    .investment-wrap {
        margin: 0 auto;
        max-width: 1480px;
    }

    .investment-header {
        align-items: end;
        display: flex;
        gap: 1rem;
        justify-content: space-between;
        margin-bottom: 1.3rem;
    }

    .investment-summary {
        display: grid;
        gap: 0;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        margin-bottom: 1rem;
        overflow: hidden;
        padding: 0;
    }

    .investment-summary div {
        border-right: 1px solid rgba(255, 255, 255, 0.07);
        padding: 1.35rem 1.55rem;
    }

    .investment-summary div:last-child {
        border-right: 0;
    }

    .investment-summary span,
    .investment-toolbar label,
    .investment-card-meta span,
    .investment-table th {
        color: var(--tj-muted);
        font-size: 0.82rem;
    }

    .investment-summary strong {
        color: var(--tj-text);
        display: block;
        font-size: clamp(1.5rem, 2.4vw, 2.4rem);
        line-height: 1;
        margin: 0.35rem 0;
    }

    .investment-summary small {
        color: var(--tj-muted);
    }

    .investment-toolbar {
        align-items: end;
        display: grid;
        gap: 1rem;
        grid-template-columns: minmax(220px, 1fr) minmax(220px, 0.7fr) minmax(280px, 1.4fr);
        margin-bottom: 1rem;
    }

    .investment-toolbar p {
        color: var(--tj-muted);
        margin: 0;
    }

    .investment-loading {
        align-items: center;
        display: flex;
        gap: 0.8rem;
        justify-content: center;
        min-height: 180px;
    }

    .investment-loading span {
        animation: emaPulse 1.1s ease-in-out infinite;
        background: linear-gradient(135deg, var(--tj-teal), var(--tj-violet));
        border-radius: 999px;
        height: 12px;
        opacity: 0.45;
        width: 12px;
    }

    .investment-loading span:nth-child(2) {
        animation-delay: 0.14s;
    }

    .investment-loading span:nth-child(3) {
        animation-delay: 0.28s;
    }

    @@keyframes emaPulse {
        50% {
            opacity: 1;
            transform: translateY(-8px);
        }
    }

    .investment-grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin-bottom: 1rem;
    }

    .investment-card {
        background:
            radial-gradient(circle at top right, rgba(32, 199, 185, 0.16), transparent 38%),
            linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.035));
        border: 1px solid var(--tj-border);
        border-radius: 22px;
        box-shadow: 0 22px 55px rgba(0, 0, 0, 0.26);
        color: var(--tj-text);
        display: flex;
        flex-direction: column;
        min-height: 285px;
        padding: 1.2rem;
        text-decoration: none;
        transition: border-color 0.18s ease, transform 0.18s ease;
    }

    .investment-card:hover {
        border-color: rgba(32, 199, 185, 0.44);
        color: var(--tj-text);
        transform: translateY(-2px);
    }

    .investment-card-head {
        align-items: flex-start;
        display: flex;
        justify-content: space-between;
        gap: 1rem;
    }

    .investment-card h2 {
        font-size: 2rem;
        margin: 0;
    }

    .investment-card p {
        color: var(--tj-muted);
        margin: 0.15rem 0 0;
    }

    .investment-score {
        align-items: center;
        background: rgba(245, 193, 75, 0.16);
        border: 1px solid rgba(245, 193, 75, 0.44);
        border-radius: 999px;
        color: #ffdd7a;
        display: inline-flex;
        font-size: 1.1rem;
        font-weight: 900;
        height: 58px;
        justify-content: center;
        min-width: 58px;
    }

    .investment-status {
        align-items: center;
        border-radius: 999px;
        display: inline-flex;
        font-size: 0.78rem;
        font-weight: 900;
        margin-top: 0.7rem;
        padding: 0.38rem 0.65rem;
        width: fit-content;
    }

    .investment-status.match {
        background: rgba(32, 199, 185, 0.17);
        border: 1px solid rgba(32, 199, 185, 0.42);
        color: #63fff1;
    }

    .investment-status.watch {
        background: rgba(245, 193, 75, 0.14);
        border: 1px solid rgba(245, 193, 75, 0.42);
        color: #ffdd7a;
    }

    .investment-card-meta {
        display: grid;
        gap: 0.6rem;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin: 1rem 0;
    }

    .investment-card-meta div {
        background: rgba(0, 0, 0, 0.18);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px;
        padding: 0.7rem;
    }

    .investment-card-meta strong {
        display: block;
        font-size: 1rem;
        margin-top: 0.2rem;
    }

    .investment-card .rationale {
        color: rgba(238, 242, 247, 0.82);
        font-size: 0.92rem;
        line-height: 1.45;
        margin-top: auto;
    }

    .investment-table {
        margin-top: 1rem;
    }

    .investment-table table {
        border-collapse: collapse;
        width: 100%;
    }

    .investment-table th,
    .investment-table td {
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
        padding: 0.9rem 0.75rem;
        white-space: nowrap;
    }

    .investment-table td:nth-child(2) {
        white-space: normal;
    }

    .investment-empty {
        padding: 2rem;
        text-align: center;
    }

    .investment-empty h2 {
        margin-bottom: 0.5rem;
    }

    .investment-disclaimer {
        color: var(--tj-muted);
        font-size: 0.85rem;
        margin: 1rem 0 0;
    }

    @@media (max-width: 1200px) {
        .investment-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .investment-summary {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .investment-toolbar {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 760px) {
        .investment-header {
            align-items: stretch;
            flex-direction: column;
        }

        .investment-grid,
        .investment-summary {
            grid-template-columns: 1fr;
        }
    }
</style>

@section Scripts {
    <script>
        (() => {
            const dataUrl = '@Url.Action("UnderEma200Data", "Investments")';
            const state = { items: [] };
            const currency = new Intl.NumberFormat('cs-CZ', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            const percent = new Intl.NumberFormat('cs-CZ', { minimumFractionDigits: 1, maximumFractionDigits: 1 });

            const elements = {
                count: document.getElementById('emaCount'),
                avgDiscount: document.getElementById('emaAvgDiscount'),
                updatedAt: document.getElementById('emaUpdatedAt'),
                message: document.getElementById('emaMessage'),
                loading: document.getElementById('emaLoading'),
                cards: document.getElementById('emaCards'),
                empty: document.getElementById('emaEmpty'),
                rows: document.getElementById('emaRows'),
                tableWrap: document.getElementById('emaTableWrap'),
                tableCount: document.getElementById('emaTableCount'),
                search: document.getElementById('emaSearch'),
                sector: document.getElementById('emaSector'),
                refresh: document.getElementById('emaRefresh')
            };

            const escapeHtml = (value) => String(value ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');

            const formatPrice = (value) => value == null ? '-' : currency.format(value);
            const formatPercent = (value) => value == null ? '-' : `${percent.format(value)} %`;

            function filteredItems() {
                const query = elements.search.value.trim().toLowerCase();
                const sector = elements.sector.value;
                return state.items.filter(item => {
                    const matchesQuery = !query ||
                        item.symbol.toLowerCase().includes(query) ||
                        item.name.toLowerCase().includes(query);
                    const matchesSector = !sector || item.sector === sector;
                    return matchesQuery && matchesSector;
                });
            }

            function renderSectorOptions() {
                const sectors = [...new Set(state.items.map(item => item.sector).filter(Boolean))].sort();
                elements.sector.innerHTML = '<option value="">Vsechny sektory</option>' +
                    sectors.map(sector => `<option value="${escapeHtml(sector)}">${escapeHtml(sector)}</option>`).join('');
            }

            function render() {
                const items = filteredItems();
                const avgDiscount = items.length
                    ? items.reduce((sum, item) => sum + item.discountToEmaPercent, 0) / items.length
                    : null;

                elements.count.textContent = items.length;
                elements.avgDiscount.textContent = avgDiscount === null ? '-' : formatPercent(avgDiscount);
                elements.tableCount.textContent = `${items.length} ${items.length === 1 ? 'firma' : 'firem'}`;

                elements.cards.hidden = items.length === 0;
                elements.tableWrap.hidden = items.length === 0;
                elements.empty.hidden = items.length > 0 || elements.loading.hidden === false;

                elements.cards.innerHTML = items.map(item => `
                    <a class="investment-card" href="${escapeHtml(item.chartUrl)}" target="_blank" rel="noopener">
                        <div class="investment-card-head">
                            <div>
                                <h2>${escapeHtml(item.symbol)}</h2>
                                <p>${escapeHtml(item.name)}</p>
                                <span class="investment-status ${item.matchesTrendPullback ? 'match' : 'watch'}">${item.matchesTrendPullback ? 'Pod rising EMA200' : 'Watchlist kandidat'}</span>
                            </div>
                            <span class="investment-score">${item.score}/100</span>
                        </div>
                        <div class="investment-card-meta">
                            <div>
                                <span>Cena</span>
                                <strong>${formatPrice(item.price)}</strong>
                            </div>
                            <div>
                                <span>Weekly EMA200</span>
                                <strong>${formatPrice(item.weeklyEma200)}</strong>
                            </div>
                            <div>
                                <span>Pod EMA</span>
                                <strong>${item.discountToEmaPercent <= 0 ? formatPercent(item.discountToEmaPercent) : `+${formatPercent(item.discountToEmaPercent)}`}</strong>
                            </div>
                        </div>
                        <div class="investment-card-meta">
                            <div>
                                <span>EMA 52w</span>
                                <strong>+${formatPercent(item.emaSlope52WeekPercent)}</strong>
                            </div>
                            <div>
                                <span>5 let</span>
                                <strong>+${formatPercent(item.return5YearPercent)}</strong>
                            </div>
                            <div>
                                <span>Above EMA</span>
                                <strong>${formatPercent(item.weeksAboveEmaSharePercent)}</strong>
                            </div>
                        </div>
                        <p class="rationale">${escapeHtml(item.rationale)}</p>
                    </a>
                `).join('');

                elements.rows.innerHTML = items.map(item => `
                    <tr>
                        <td><strong>${escapeHtml(item.symbol)}</strong></td>
                        <td>${escapeHtml(item.name)}</td>
                        <td>${formatPrice(item.price)}</td>
                        <td>${formatPrice(item.weeklyEma200)}</td>
                        <td>${item.discountToEmaPercent <= 0 ? formatPercent(item.discountToEmaPercent) : `+${formatPercent(item.discountToEmaPercent)}`}</td>
                        <td>${item.emaSlope52WeekPercent >= 0 ? '+' : ''}${formatPercent(item.emaSlope52WeekPercent)}</td>
                        <td>${item.return5YearPercent >= 0 ? '+' : ''}${formatPercent(item.return5YearPercent)}</td>
                        <td><strong>${item.score}/100</strong></td>
                    </tr>
                `).join('');
            }

            async function loadData(forceRefresh = false) {
                elements.loading.hidden = false;
                elements.cards.hidden = true;
                elements.empty.hidden = true;
                elements.refresh.disabled = true;

                try {
                    const url = forceRefresh ? `${dataUrl}?refresh=true` : dataUrl;
                    const response = await fetch(url, { headers: { 'Accept': 'application/json' } });
                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}`);
                    }

                    const data = await response.json();
                    state.items = data.items || [];
                    elements.updatedAt.textContent = data.updatedAt || 'bez casu';
                    elements.message.textContent = data.message || 'Screening dokoncen.';
                    renderSectorOptions();
                    render();
                } catch {
                    state.items = [];
                    elements.updatedAt.textContent = 'chyba';
                    elements.message.textContent = 'Live screening se ted nepodarilo nacist.';
                    render();
                } finally {
                    elements.loading.hidden = true;
                    elements.refresh.disabled = false;
                    elements.empty.hidden = state.items.length > 0;
                }
            }

            elements.search.addEventListener('input', render);
            elements.sector.addEventListener('change', render);
            elements.refresh.addEventListener('click', () => loadData(true));
            loadData();
        })();
    </script>
}
