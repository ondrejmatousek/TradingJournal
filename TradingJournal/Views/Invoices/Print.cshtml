@model TradingJournal.Models.Invoice
@using System.Globalization

@{
    Layout = null;

    var culture = CultureInfo.GetCultureInfo("cs-CZ");
    var supplier = Model.SupplierCompany;
    var customer = Model.CustomerCompany;
    var supplierIsVatPayer = supplier?.IsVatPayer == true;
    var account = supplier?.BankAccount ?? supplier?.Iban ?? string.Empty;
    var variableSymbol = DigitsOnly(Model.InvoiceNumber);
    var invoiceNumber = !string.IsNullOrWhiteSpace(variableSymbol) ? variableSymbol : Model.InvoiceNumber;
    var paymentQrCodeDataUri = ViewBag.PaymentQrCodeDataUri as string;
    var invoiceTitle = "FAKTURA – DOKLAD";
    var invoiceTotal = supplierIsVatPayer ? Model.TotalGross : Model.TotalNet;
    var lines = Model.Items
        .GroupBy(i => new { i.Unit, i.UnitPrice, VatRate = supplierIsVatPayer ? i.VatRate : 0m })
        .Select(g => new PrintableLine(
            g.Key.Unit.Equals("hod", StringComparison.OrdinalIgnoreCase) ? "Expertní vývojové práce MS.NET" : string.Join(", ", g.Select(i => i.Description).Distinct()),
            g.Sum(i => i.Quantity),
            g.Key.Unit,
            g.Key.UnitPrice,
            g.Key.VatRate))
        .ToList();
}

<!doctype html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Faktura @invoiceNumber - EdgeDesk</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <style>
        @@page {
            margin: 7mm;
            size: A4;
        }

        * {
            box-sizing: border-box;
        }

        body {
            background: #eef1f3;
            color: #000;
            font-family: Arial, Helvetica, sans-serif;
            font-size: 10.5px;
            line-height: 1.08;
            margin: 0;
        }

        .toolbar {
            align-items: center;
            display: flex;
            gap: 10px;
            justify-content: center;
            padding: 16px;
        }

        .toolbar a,
        .toolbar button {
            background: #090921;
            border: 0;
            border-radius: 999px;
            color: #fff;
            cursor: pointer;
            font-weight: 700;
            padding: 10px 16px;
            text-decoration: none;
        }

        .sheet {
            background: #fff;
            box-shadow: 0 18px 70px rgba(20, 27, 33, 0.16);
            margin: 0 auto 24px;
            min-height: 297mm;
            padding: 6mm 7mm 8mm;
            width: 210mm;
        }

        .invoice {
            border: 1px solid #000;
            margin: 0 auto;
            min-height: 276mm;
            position: relative;
            width: 188mm;
        }

        .top-title {
            align-items: end;
            display: grid;
            grid-template-columns: 1fr 1.05fr;
            padding: 2px 8px 1px;
        }

        .top-title .company {
            font-size: 16px;
            font-weight: 800;
        }

        .top-title .number {
            color: #000066;
            font-size: 16px;
            font-weight: 800;
            text-align: right;
        }

        .header-grid {
            border-top: 1px solid #000;
            display: grid;
            grid-template-columns: 1fr 0.96fr;
        }

        .supplier-panel {
            border-right: 1px solid #000;
            display: grid;
            grid-template-rows: 150px 42px 90px;
        }

        .supplier-box {
            padding: 7px 18px 6px;
        }

        .label {
            color: #000066;
            font-weight: 400;
        }

        .supplier-data {
            margin-top: 14px;
        }

        .strong-line {
            font-size: 12px;
            font-weight: 800;
            line-height: 1.05;
        }

        .supplier-meta {
            color: #000066;
            margin-top: 12px;
            max-width: 220px;
        }

        .account-row {
            align-items: center;
            border-top: 1px solid #000;
            display: grid;
            grid-template-columns: 68px 1fr;
            padding: 0 18px;
        }

        .account-box {
            border: 2px solid #000;
            display: grid;
            grid-template-columns: 1fr 48px;
            height: 19px;
        }

        .account-box span {
            align-items: center;
            border-right: 1px solid #000;
            display: flex;
            justify-content: end;
            padding: 0 5px;
        }

        .account-box span:last-child {
            border-right: 0;
        }

        .date-box {
            border-top: 1px solid #000;
            padding: 8px 18px;
        }

        .date-row {
            align-items: center;
            display: grid;
            grid-template-columns: 1fr 104px;
            margin-bottom: 2px;
        }

        .date-row strong {
            border: 1px solid #000;
            font-weight: 400;
            padding: 2px 6px;
            text-align: right;
        }

        .payment-row {
            display: grid;
            grid-template-columns: 1fr 104px;
            margin-top: 8px;
        }

        .payment-row span:last-child {
            text-align: right;
        }

        .right-panel {
            display: grid;
            grid-template-rows: 74px 188px;
        }

        .symbols {
            border-bottom: 4px solid #000;
            display: grid;
            grid-template-columns: 1fr 118px;
            padding: 7px 12px;
        }

        .symbols .name,
        .symbols .value {
            display: grid;
            gap: 6px;
        }

        .symbols .value {
            text-align: right;
        }

        .customer-box {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 118px;
            grid-template-rows: auto 1fr;
            padding: 8px 12px;
        }

        .customer-address {
            align-self: start;
            grid-column: 1;
            grid-row: 2;
            padding-left: 24px;
            padding-top: 10px;
        }

        .customer-address .strong-line:first-child {
            font-size: 11px;
            white-space: nowrap;
        }

        .customer-ids {
            align-self: start;
            color: #000066;
            display: grid;
            grid-column: 2;
            grid-row: 1 / span 2;
            grid-template-columns: 34px 1fr;
            grid-auto-rows: min-content;
            padding-top: 4px;
            text-align: right;
        }

        .customer-ids span:nth-child(odd) {
            text-align: left;
        }

        table {
            border-collapse: collapse;
            width: 100%;
        }

        .items {
            border-top: 1px solid #000;
        }

        .items th,
        .items td {
            padding: 4px 8px;
        }

        .items th {
            border-bottom: 1px solid #000;
            font-weight: 400;
            text-align: right;
        }

        .items th:first-child,
        .items td:first-child {
            text-align: left;
        }

        .items td {
            text-align: right;
        }

        .description-line td {
            color: #000066;
            font-size: 12px;
            padding: 8px 26px 6px;
            text-align: left !important;
        }

        .data-line td {
            padding-bottom: 2px;
            padding-top: 2px;
        }

        .summary-line td {
            border-top: 1px solid #000;
            padding-top: 8px;
        }

        .total-line td {
            border-top: 1px solid #000;
            font-size: 13px;
            font-weight: 800;
            padding-bottom: 7px;
            padding-top: 6px;
        }

        .invoice-spacer {
            border-top: 1px solid #000;
            color: #000066;
            font-size: 10.5px;
            min-height: 238px;
            padding: 12px 26px;
            white-space: pre-line;
        }

        .payment-qr-section {
            border-top: 1px solid #000;
            display: grid;
            grid-template-columns: 124px 1fr;
            gap: 16px;
            min-height: 126px;
            padding: 10px 26px;
        }

        .payment-qr img {
            display: block;
            height: 104px;
            image-rendering: pixelated;
            width: 104px;
        }

        .payment-qr-label {
            font-size: 9px;
            font-weight: 800;
            margin-top: 3px;
            text-align: center;
            width: 104px;
        }

        .vat-recap {
            align-self: start;
            justify-self: end;
            max-width: 420px;
            width: 100%;
        }

        .vat-recap th,
        .vat-recap td {
            padding: 3px 6px;
            text-align: right;
        }

        .vat-recap th:first-child,
        .vat-recap td:first-child {
            text-align: left;
        }

        @@media print {
            body {
                background: #fff;
            }

            .toolbar {
                display: none;
            }

            .sheet {
                box-shadow: none;
                margin: 0;
                min-height: auto;
                padding: 0;
                width: auto;
            }

            .invoice {
                min-height: calc(297mm - 14mm);
                width: auto;
            }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <button type="button" onclick="window.print()">Vytisknout / uložit PDF</button>
        <a href="@Url.Action("Details", "Invoices", new { id = Model.Id })">Zpět na detail</a>
    </div>

    <main class="sheet">
        <section class="invoice">
            <header class="top-title">
                <div class="company">@supplier?.Name</div>
                <div class="number">@invoiceTitle č. @invoiceNumber</div>
            </header>

            <section class="header-grid">
                <div class="supplier-panel">
                    <div class="supplier-box">
                        <div class="label">Dodavatel:</div>
                        <div class="supplier-data">
                            <div class="strong-line">@supplier?.Name</div>
                            <div class="strong-line">@supplier?.Street</div>
                            <div class="strong-line">@supplier?.ZipCode @supplier?.City</div>
                        </div>
                        <div class="supplier-meta">
                            <div>IČ: @supplier?.RegistrationNumber</div>
                            @if (supplier?.IsVatPayer == true && !string.IsNullOrWhiteSpace(supplier.TaxNumber))
                            {
                                <div>DIČ: @supplier.TaxNumber</div>
                            }
                            @if (!supplierIsVatPayer)
                            {
                                <div>Nejsem plátce DPH.</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(supplier?.Phone))
                            {
                                <div>Telefon: @supplier.Phone</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(supplier?.Email))
                            {
                                <div>E-mail: @supplier.Email</div>
                            }
                        </div>
                    </div>

                    <div class="account-row">
                        <span>Číslo účtu:</span>
                        <div class="account-box">
                            <span>@AccountNumber(account)</span>
                            <span>@BankCode(account)</span>
                        </div>
                    </div>

                    <div class="date-box">
                        <div class="date-row"><span>Datum vystavení:</span><strong>@Model.IssueDate.ToString("dd.MM.yyyy", culture)</strong></div>
                        <div class="date-row"><span>Datum splatnosti:</span><strong>@Model.DueDate.ToString("dd.MM.yyyy", culture)</strong></div>
                        @if (supplierIsVatPayer)
                        {
                            <div class="date-row"><span>Datum uskutečnění plnění:</span><strong>@(Model.TaxableSupplyDate?.ToString("dd.MM.yyyy", culture) ?? "-")</strong></div>
                        }
                        <div class="payment-row"><span>Forma úhrady:</span><span>Příkazem</span></div>
                    </div>
                </div>

                <div class="right-panel">
                    <div class="symbols">
                        <div class="name">
                            <span>Variabilní symbol:</span>
                            <span>Konstantní symbol:</span>
                            <span>Objednávka č.:</span>
                        </div>
                        <div class="value">
                            <span>@invoiceNumber</span>
                            <span>0308</span>
                            <span></span>
                        </div>
                    </div>
                    <div class="customer-box">
                        <div class="label">Odběratel:</div>
                        <div class="customer-address">
                            <div class="strong-line">@customer?.Name</div>
                            <div class="strong-line">@customer?.Street</div>
                            <div class="strong-line">@customer?.ZipCode @customer?.City</div>
                        </div>
                        <div class="customer-ids">
                            <span>IČ:</span><span>@customer?.RegistrationNumber</span>
                            @if (customer?.IsVatPayer == true && !string.IsNullOrWhiteSpace(customer.TaxNumber))
                            {
                                <span>DIČ:</span><span>@customer.TaxNumber</span>
                            }
                        </div>
                    </div>
                </div>
            </section>

            <table class="items">
                <thead>
                    <tr>
                        <th>Označení dodávky</th>
                        <th>Množství</th>
                        <th>Jednotková cena</th>
                        @if (supplierIsVatPayer)
                        {
                            <th>Sleva</th>
                            <th>Cena</th>
                            <th>%DPH</th>
                            <th>DPH</th>
                        }
                        <th>Cena celkem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in lines)
                    {
                        <tr class="data-line">
                            <td>@line.Description.ToLowerInvariant()</td>
                            <td>@line.Quantity.ToString("N2", culture) @line.Unit</td>
                            <td>@line.UnitPrice.ToString("N2", culture)</td>
                            @if (supplierIsVatPayer)
                            {
                                <td>0%</td>
                                <td>@line.TotalNet.ToString("N2", culture)</td>
                                <td>@line.VatRate.ToString("N0", culture)%</td>
                                <td>@line.TotalVat.ToString("N2", culture)</td>
                            }
                            <td>@((supplierIsVatPayer ? line.TotalGross : line.TotalNet).ToString("N2", culture))</td>
                        </tr>
                    }
                    <tr class="summary-line">
                        <td>Součet položek</td>
                        @if (supplierIsVatPayer)
                        {
                            <td colspan="3"></td>
                            <td>@Model.TotalNet.ToString("N2", culture)</td>
                            <td></td>
                            <td>@Model.TotalVat.ToString("N2", culture)</td>
                            <td>@invoiceTotal.ToString("N2", culture)</td>
                        }
                        else
                        {
                            <td colspan="2"></td>
                            <td>@invoiceTotal.ToString("N2", culture)</td>
                        }
                    </tr>
                    <tr class="total-line">
                        <td colspan="@(supplierIsVatPayer ? 7 : 3)">CELKEM K ÚHRADĚ</td>
                        <td>@invoiceTotal.ToString("N2", culture)</td>
                    </tr>
                </tbody>
            </table>

            <section class="invoice-spacer">@if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    @Model.Notes
                }</section>

            <section class="payment-qr-section">
                <div class="payment-qr">
                    @if (!string.IsNullOrWhiteSpace(paymentQrCodeDataUri))
                    {
                        <img src="@paymentQrCodeDataUri" alt="QR platba" />
                        <div class="payment-qr-label">QR platba</div>
                    }
                    else
                    {
                        <div class="payment-qr-label">QR platba není dostupná</div>
                    }
                </div>
                @if (supplierIsVatPayer)
                {
                    <table class="vat-recap">
                        <thead>
                            <tr>
                                <th>Rekapitulace DPH v Kč:</th>
                                <th>Základ v Kč</th>
                                <th>Sazba</th>
                                <th>DPH v Kč</th>
                                <th>Celkem s DPH v Kč</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td></td>
                                <td>@Model.TotalNet.ToString("N2", culture)</td>
                                <td>@(Model.TotalVat == 0 ? "0%" : "")</td>
                                <td>@Model.TotalVat.ToString("N2", culture)</td>
                                <td>@invoiceTotal.ToString("N2", culture)</td>
                            </tr>
                        </tbody>
                    </table>
                }
            </section>
        </section>
    </main>
</body>
</html>

@functions {
    private sealed record PrintableLine(string Description, decimal Quantity, string Unit, decimal UnitPrice, decimal VatRate)
    {
        public decimal TotalNet => Quantity * UnitPrice;
        public decimal TotalVat => TotalNet * VatRate / 100m;
        public decimal TotalGross => TotalNet + TotalVat;
    }

    private static string DigitsOnly(string? value)
        => new((value ?? string.Empty).Where(char.IsDigit).ToArray());

    private static string AccountNumber(string? account)
    {
        if (string.IsNullOrWhiteSpace(account))
            return string.Empty;

        var cleaned = account.Trim();
        var slashIndex = cleaned.LastIndexOf('/');
        return slashIndex > 0 ? cleaned[..slashIndex] : cleaned;
    }

    private static string BankCode(string? account)
    {
        if (string.IsNullOrWhiteSpace(account))
            return string.Empty;

        var cleaned = account.Trim();
        var slashIndex = cleaned.LastIndexOf('/');
        return slashIndex >= 0 && slashIndex < cleaned.Length - 1 ? cleaned[(slashIndex + 1)..] : string.Empty;
    }
}
