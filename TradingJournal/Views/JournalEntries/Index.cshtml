@model TradingJournal.ViewModels.JournalIndexViewModel
@using TradingJournal.Models
@using System.Globalization

@{
    ViewData["Title"] = "Journal";
    ViewData["BodyClass"] = "journal-shell";
    var czechCulture = new CultureInfo("cs-CZ");

    var hasActiveFilters = Model.Filters.Asset.HasValue
        || Model.Filters.Outcome.HasValue
        || Model.Filters.Side.HasValue
        || Model.Filters.PlanOnly;

    string SignedMove(decimal value)
    {
        if (value > 0)
            return "+" + value.ToString("0.##", czechCulture);

        return value.ToString("0.##", czechCulture);
    }

    var selectedDayTitle = Model.Calendar.SelectedDate.ToDateTime(TimeOnly.MinValue).ToString("d. MMMM yyyy", czechCulture);
    var monthTitle = Model.Calendar.Month.ToDateTime(TimeOnly.MinValue).ToString("MMMM yyyy", czechCulture);
}

<div class="journal-page">
<partial name="_JournalBreadcrumb" />

    <div class="journal-wrap">
        <div class="journal-header">
            <div>
                <div class="eyebrow">Trading desk</div>
                <h1>@(((TradingJournal.Models.TradingJournalBook)ViewData["CurrentJournal"]!).Name)</h1>
                <p>Your trades, filtered insights, and process quality.</p>
            </div>
            <a asp-action="Create" class="btn btn-primary">New entry</a>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-6 col-xl-2">
                <div class="stat-card h-100">
                    <div class="card-body">
                        <div class="text-muted small">Trades</div>
                        <div class="fs-3 fw-semibold">@Model.Stats.TotalTrades</div>
                        <div class="text-muted small">
                            @Model.Stats.Wins W / @Model.Stats.Losses L / @Model.Stats.Breakeven BE
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-xl-2">
                <div class="stat-card h-100">
                    <div class="card-body">
                        <div class="text-muted small">Win rate</div>
                        <div class="fs-3 fw-semibold">@Model.Stats.WinRate.ToString("0.#")%</div>
                        <div class="text-muted small">@Model.Stats.Unknown unknown</div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-xl-2">
                <div class="stat-card h-100">
                    <div class="card-body">
                        <div class="text-muted small">Plan adherence</div>
                        <div class="fs-3 fw-semibold">@Model.Stats.PlanAdherence.ToString("0.#")%</div>
                        <div class="text-muted small">Process quality</div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-xl-2">
                <div class="stat-card h-100">
                    <div class="card-body">
                        <div class="text-muted small">Average risk</div>
                        <div class="fs-3 fw-semibold">@Model.Stats.AverageRisk.ToString("0.##")%</div>
                        <div class="text-muted small">Per filtered trade</div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-4">
                <div class="stat-card h-100">
                    <div class="card-body">
                        <div class="text-muted small">Best asset</div>
                        @if (Model.Stats.BestAsset.HasValue)
                        {
                            <div class="fs-3 fw-semibold">@Model.Stats.BestAsset</div>
                            <div class="text-muted small">
                                @Model.Stats.BestAssetWinRate?.ToString("0.#")% win rate on wins/losses
                            </div>
                        }
                        else
                        {
                            <div class="fs-3 fw-semibold">-</div>
                            <div class="text-muted small">Add wins/losses to compare assets</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <form method="get" class="app-card filter-panel mb-4">
            <div class="card-body">
                <input type="hidden" name="month" value="@Model.Calendar.Month.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="selectedDate" value="@Model.Calendar.SelectedDate.ToString("yyyy-MM-dd")" />

                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">Asset</label>
                        <select name="asset" asp-items="Model.AssetOptions" class="form-select">
                            <option value="">All assets</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Outcome</label>
                        <select name="outcome" asp-items="Model.OutcomeOptions" class="form-select">
                            <option value="">All outcomes</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Side</label>
                        <select name="side" asp-items="Model.SideOptions" class="form-select">
                            <option value="">Long & Short</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="planOnly" value="true" id="planOnly"
                                   @(Model.Filters.PlanOnly ? "checked" : "") />
                            <label class="form-check-label" for="planOnly">Only plan-followed trades</label>
                        </div>

                        <div class="d-flex gap-2">
                            <button class="btn btn-primary" type="submit">Apply</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                        </div>
                    </div>
                </div>
            </div>
        </form>

        @if (!Model.Entries.Any())
        {
            <div class="alert alert-info">
                @if (hasActiveFilters)
                {
                    <span>No entries match the selected filters.</span>
                }
                else
                {
                    <span>No entries yet. Click <strong>New entry</strong> to create your first trade.</span>
                }
            </div>
        }
        else
        {
            <section class="journal-calendar-section">
                <div class="journal-calendar-header">
                    <h2>@monthTitle</h2>
                    <div class="journal-calendar-nav">
                        <a asp-action="Index"
                           asp-route-asset="@Model.Filters.Asset"
                           asp-route-outcome="@Model.Filters.Outcome"
                           asp-route-side="@Model.Filters.Side"
                           asp-route-planOnly="@Model.Filters.PlanOnly"
                           asp-route-month="@Model.Calendar.PreviousMonth.ToString("yyyy-MM-dd")"
                           asp-route-selectedDate="@Model.Calendar.PreviousMonth.ToString("yyyy-MM-dd")"
                           aria-label="Předchozí měsíc">←</a>
                        <a asp-action="Index"
                           asp-route-asset="@Model.Filters.Asset"
                           asp-route-outcome="@Model.Filters.Outcome"
                           asp-route-side="@Model.Filters.Side"
                           asp-route-planOnly="@Model.Filters.PlanOnly"
                           asp-route-month="@Model.Calendar.NextMonth.ToString("yyyy-MM-dd")"
                           asp-route-selectedDate="@Model.Calendar.NextMonth.ToString("yyyy-MM-dd")"
                           aria-label="Další měsíc">→</a>
                    </div>
                </div>

                <div class="journal-calendar-grid">
                    @foreach (var dayName in new[] { "Sun", "Mon", "Út", "St", "Čt", "Pá", "Sat" })
                    {
                        <div class="journal-calendar-weekday">@dayName</div>
                    }

                    @foreach (var day in Model.Calendar.Days)
                    {
                        <a class="journal-calendar-day @day.Tone @(day.IsCurrentMonth ? "" : "muted-month") @(day.IsSelected ? "selected" : "")"
                           asp-action="Index"
                           asp-route-asset="@Model.Filters.Asset"
                           asp-route-outcome="@Model.Filters.Outcome"
                           asp-route-side="@Model.Filters.Side"
                           asp-route-planOnly="@Model.Filters.PlanOnly"
                           asp-route-month="@Model.Calendar.Month.ToString("yyyy-MM-dd")"
                           asp-route-selectedDate="@day.Date.ToString("yyyy-MM-dd")">
                            <span class="journal-calendar-date">@day.Date.Day.</span>
                            @if (day.TradeCount > 0)
                            {
                                <span class="journal-calendar-result">@(day.HasProfitLoss ? SignedMove(day.NetMove) : "—")</span>
                                <span class="journal-calendar-count">⇄ @day.TradeCount @(day.TradeCount == 1 ? "trade" : "trades")</span>
                            }
                        </a>
                    }
                </div>
            </section>

            <section class="journal-day-trades">
                <h2>Obchody (@selectedDayTitle)</h2>
                <p class="text-muted">Zisk / ztráta v měně účtu. Nezadané částky se do součtů nezahrnují.</p>

                @if (!Model.SelectedDayEntries.Any())
                {
                    <div class="journal-day-empty">Pro tento den nejsou žádné obchody.</div>
                }
                else
                {
                    <div class="journal-trade-table-wrap">
                        <table class="journal-trade-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Symbol</th>
                                    <th>Směr</th>
                                    <th>Outcome</th>
                                    <th>Otevírací cena</th>
                                    <th>Zavírací cena</th>
                                    <th>Čas otevření</th>
                                    <th>Risk</th>
                                    <th>Výsledek</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var trade in Model.SelectedDayEntries)
                                {
                                    var entry = trade.EntryTime?.LocalDateTime;
                                    var profitLoss = trade.Status == EntryStatus.Executed ? trade.ProfitLoss : null;

                                    <tr class="clickable-card" data-href="@Url.Action("Details", "JournalEntries", new { id = trade.Id })" tabindex="0" role="link">
                                        <td>@trade.Id</td>
                                        <td class="fw-semibold">@trade.Asset</td>
                                        <td>
                                            <span class="journal-table-pill @(trade.Side == PositionSide.Long ? "long" : "short")">
                                                @(trade.Side == PositionSide.Long ? "Nákup" : "Prodej")
                                            </span>
                                        </td>
                                        <td>@(trade.Outcome == TradeOutcome.Manual ? "Zavřeno ručně" : trade.Outcome.ToString())</td>
                                        <td>@trade.EntryPrice.ToString("0.########", czechCulture)</td>
                                        <td>@(trade.ExitPrice?.ToString("0.########", czechCulture) ?? "-")</td>
                                        <td>@(entry?.ToString("d. M. yyyy H:mm:ss", czechCulture) ?? "-")</td>
                                        <td>@trade.RiskPercentage.ToString("0.##", czechCulture)%</td>
                                        <td class="journal-table-result @(profitLoss > 0 ? "positive" : profitLoss < 0 ? "negative" : "")">
                                            @(profitLoss.HasValue ? $"{SignedMove(profitLoss.Value)}" : "-")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
    </div>
</div>

<partial name="_ImagePreviewModal" />

@section Scripts {
    <script src="~/js/journal-ui.js" asp-append-version="true"></script>
}
