@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = "Trading Journal";
    ViewData["BodyClass"] = "marketing-shell";
}

<section class="home-welcome" aria-labelledby="home-title">
    <div class="home-welcome-card">
        <div class="home-welcome-copy">
            <div class="home-command-brand">
                <partial name="_AppMark" />
                <strong>Trading Journal</strong>
            </div>
            <h1 id="home-title">Trading Journal a investiční výzkum</h1>
            <p>
                Jedno místo pro obchodní journal, analýzu trhu a screening akcií.
                Přihlaste se a pokračujte do aplikace.
            </p>
            <div class="home-command-actions">
                @if (SignInManager.IsSignedIn(User))
                {
                    <a asp-controller="TradingJournals" asp-action="Index" class="home-action primary">Otevřít aplikaci</a>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login" class="home-action primary">Přihlásit se</a>
                    <a asp-area="Identity" asp-page="/Account/Register" class="home-action">Vytvořit účet</a>
                }
            </div>
        </div>
        <figure class="home-promo">
            <img src="~/images/trading-journal-promo.png" asp-append-version="true"
                 alt="Ilustrační náhled Trading Journalu s grafem výkonnosti, přehledem obchodů a statistikami."
                 width="1672" height="941" fetchpriority="high" />
            <figcaption>Obchody. Statistiky. Souvislosti. · Ilustrační vizuál</figcaption>
        </figure>
    </div>
</section>
