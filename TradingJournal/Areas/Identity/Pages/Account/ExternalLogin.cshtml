@page
@model TradingJournal.Areas.Identity.Pages.Account.ExternalLoginModel
@{
    ViewData["Title"] = "External login";
}

<div class="container-lg">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1>@ViewData["Title"]</h1>
            <div class="alert alert-danger">
                External login could not be completed. Please try again.
            </div>
            <a asp-page="./Login" class="btn btn-primary">Back to login</a>
        </div>
    </div>
</div>
