@model TradingJournal.ViewModels.UnderEma200Result
@{
    ViewData["Title"] = "Pod 200 EMA";
    ViewData["BodyClass"] = "journal-shell";
    var dailySelected = Model.Timeframe == "Daily" ? "selected" : null;
    var weeklySelected = Model.Timeframe == "Weekly" ? "selected" : null;
}

<div class="journal-page investment-page">
    <div class="investment-wrap">
        <div class="journal-header investment-header">
            <div>
                <div class="eyebrow">Investment radar</div>
                <h1>Pod @Model.EmaLabel</h1>
                <p><strong>@Model.TimeframeLabel</strong> screening firem, ktere jsou pod vybranou EMA200, ale dlouhodobe porad vypadaji rustove.</p>
            </div>
            <div class="page-actions">
                <label class="timeframe-picker" for="emaTimeframe">
                    <span>Timeframe</span>
                    <select id="emaTimeframe" class="form-select">
                        <option value="Daily" selected="@dailySelected">Daily EMA 200</option>
                        <option value="Weekly" selected="@weeklySelected">Weekly EMA 200</option>
                    </select>
                </label>
                <button type="button" class="btn btn-primary" id="emaRefresh">Refresh</button>
            </div>
        </div>

        <section class="investment-summary app-card">
            <div>
                <span>Kandidati</span>
                <strong id="emaQualifiedCount">-</strong>
                <small>prosli growth filtrem</small>
            </div>
            <div>
                <span>Ulozeno</span>
                <strong id="emaTotalCount">-</strong>
                <small>snapshotu v databazi</small>
            </div>
            <div>
                <span>Prumerna vzdalenost</span>
                <strong id="emaAvgDistance">-</strong>
                <small id="emaDistanceLabel">vuci @Model.EmaLabel</small>
            </div>
            <div>
                <span>Posledni vypocet</span>
                <strong id="emaUpdatedAt">-</strong>
                <small id="emaSource">Yahoo / Alpha / Stooq</small>
            </div>
        </section>

        <div class="investment-content">
            <main class="investment-main">
                <section class="investment-toolbar app-card">
                    <div>
                        <label for="emaSearch">Hledat</label>
                        <input id="emaSearch" class="form-control" type="search" placeholder="Ticker nebo firma" autocomplete="off" />
                    </div>
                    <div>
                        <label for="emaSector">Sektor</label>
                        <select id="emaSector" class="form-select">
                            <option value="">Vsechny sektory</option>
                        </select>
                    </div>
                    <div>
                        <label for="emaSort">Seradit</label>
                        <select id="emaSort" class="form-select">
                            <option value="score">Skore</option>
                            <option value="distance">Vzdalenost pod EMA200</option>
                            <option value="fiveYear">5Y vykon</option>
                        </select>
                    </div>
                    <p id="emaMessage">Nacitam ulozeny screening...</p>
                </section>

                <section class="investment-loading app-card" id="emaLoading" aria-label="Nacitam screening">
                    <span></span>
                    <span></span>
                    <span></span>
                </section>

                <section class="investment-section" id="qualifiedSection" hidden>
                    <div class="panel-title">
                        <span>Opravdu pod @Model.EmaLabel a splnuji growth filtr</span>
                        <strong id="qualifiedCount">0</strong>
                    </div>
                    <div class="investment-grid" id="qualifiedCards"></div>
                </section>

                <section class="investment-section" id="failedSection" hidden>
                    <div class="panel-title">
                        <span>Pod @Model.EmaLabel, ale neprosly growth filtrem</span>
                        <strong id="failedCount">0</strong>
                    </div>
                    <div class="investment-grid failed-grid" id="failedCards"></div>
                </section>

                <section class="investment-empty app-card" id="emaEmpty" hidden>
                    <h2>Zatim nic ve filtru</h2>
                    <p>Bud nejsou dostupna data, nebo zadna firma z watchlistu aktualne neni pod vybranou EMA200.</p>
                </section>

                <section class="investment-table app-card" id="emaTableWrap" hidden>
                    <div class="panel-title">
                        <span>Detail screeningu</span>
                        <strong id="emaTableCount">0 firem</strong>
                    </div>
                    <div class="table-responsive">
                        <table>
                            <thead>
                                <tr>
                                    <th>Ticker</th>
                                    <th>Firma</th>
                                    <th>Cena</th>
                                    <th id="emaTableHeader">@Model.EmaLabel</th>
                                    <th>Pod EMA</th>
                                    <th>1Y</th>
                                    <th>3Y</th>
                                    <th>5Y</th>
                                    <th>Skore</th>
                                    <th>Stav</th>
                                    <th>Vypocet</th>
                                </tr>
                            </thead>
                            <tbody id="emaRows"></tbody>
                        </table>
                    </div>
                </section>
            </main>

            <aside class="investment-side">
                <section class="investment-rules app-card">
                    <div>
                        <span class="eyebrow">Jak se seznam sklada</span>
                        <h2>Trend + pullback pod @Model.EmaLabel</h2>
                        <p>
                            Screening bere watchlist kvalitnich rustovych firem, prepocita vybranou EMA200 a rozdeli firmy na ty,
                            ktere jsou opravdu pod ni, a na zbytek watchlistu pro kontrolu.
                        </p>
                    </div>
                    <div class="rules-grid">
                        <div>
                            <strong>Qualified</strong>
                            <span>Cena je pod @Model.EmaLabel, 5Y vykon alespon +20 %, 3Y vykon kladny a sleva od EMA neni hlubsi nez 35 %.</span>
                        </div>
                        <div>
                            <strong>Pod EMA, ale slabsi filtr</strong>
                            <span>Akcie je pod @Model.EmaLabel, ale neprosla rustovym filtrem nebo je prilis hluboko pod EMA.</span>
                        </div>
                        <div>
                            <strong>Radim podle</strong>
                            <span>Vychozi razeni je skore. Prepnout jde na vzdalenost pod EMA200 nebo 5Y vykon.</span>
                        </div>
                    </div>
                </section>
            </aside>
        </div>

        <p class="investment-disclaimer">Technicky screening pro watchlist. Neni to investicni doporuceni ani signal k nakupu.</p>
    </div>
</div>

<style>
    .investment-page {
        padding: clamp(1.1rem, 2vw, 2rem);
    }

    .investment-wrap {
        margin: 0 auto;
        max-width: 1360px;
    }

    .investment-header {
        align-items: end;
        display: flex;
        gap: 1rem;
        justify-content: space-between;
        margin-bottom: 1.3rem;
    }

    .page-actions {
        align-items: end;
        display: flex;
        gap: 0.75rem;
    }

    .timeframe-picker {
        min-width: 190px;
    }

    .timeframe-picker span {
        color: var(--tj-muted);
        display: block;
        font-size: 0.76rem;
        font-weight: 800;
        margin-bottom: 0.25rem;
        text-transform: uppercase;
    }

    .investment-summary {
        display: grid;
        gap: 0;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        margin-bottom: 1rem;
        overflow: hidden;
        padding: 0;
    }

    .investment-summary div {
        border-right: 1px solid rgba(255, 255, 255, 0.07);
        padding: 1.25rem 1.45rem;
    }

    .investment-summary div:last-child {
        border-right: 0;
    }

    .investment-summary span,
    .investment-toolbar label,
    .investment-card-meta span,
    .investment-table th {
        color: var(--tj-muted);
        font-size: 0.82rem;
    }

    .investment-summary strong {
        color: var(--tj-text);
        display: block;
        font-size: clamp(1.4rem, 2.2vw, 2.2rem);
        line-height: 1;
        margin: 0.35rem 0;
    }

    .investment-summary small {
        color: var(--tj-muted);
    }

    .investment-content {
        align-items: start;
        display: grid;
        gap: 1.25rem;
        grid-template-columns: minmax(0, 1fr) minmax(260px, 300px);
    }

    .investment-main {
        min-width: 0;
    }

    .investment-side {
        min-width: 0;
        position: sticky;
        top: 5rem;
    }

    .investment-rules {
        display: block;
        margin-bottom: 0;
        padding: 0.85rem;
    }

    .investment-rules h2 {
        font-size: 1.08rem;
        line-height: 1.15;
        margin: 0.1rem 0 0.35rem;
    }

    .investment-rules p,
    .rules-grid span {
        color: var(--tj-muted);
        font-size: 0.78rem;
        line-height: 1.35;
        margin: 0;
    }

    .rules-grid {
        display: grid;
        gap: 0.55rem;
        grid-template-columns: 1fr;
        margin-top: 0.75rem;
    }

    .rules-grid div {
        background: rgba(0, 0, 0, 0.16);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        min-height: auto;
        padding: 0.58rem;
    }

    .rules-grid strong {
        color: var(--tj-text);
        display: block;
        font-size: 0.82rem;
        margin-bottom: 0.35rem;
    }

    .investment-toolbar {
        align-items: end;
        display: grid;
        gap: 0.75rem;
        grid-template-columns: minmax(180px, 1fr) minmax(160px, 0.72fr) minmax(160px, 0.72fr);
        margin-bottom: 1rem;
    }

    .investment-toolbar p {
        color: var(--tj-muted);
        grid-column: 1 / -1;
        margin: 0;
    }

    .investment-loading {
        align-items: center;
        display: flex;
        gap: 0.8rem;
        justify-content: center;
        min-height: 180px;
    }

    .investment-loading span {
        animation: emaPulse 1.1s ease-in-out infinite;
        background: linear-gradient(135deg, var(--tj-teal), var(--tj-violet));
        border-radius: 999px;
        height: 12px;
        opacity: 0.45;
        width: 12px;
    }

    .investment-loading span:nth-child(2) {
        animation-delay: 0.14s;
    }

    .investment-loading span:nth-child(3) {
        animation-delay: 0.28s;
    }

    @@keyframes emaPulse {
        50% {
            opacity: 1;
            transform: translateY(-8px);
        }
    }

    .investment-section {
        margin-bottom: 1rem;
    }

    .investment-section .panel-title {
        margin: 0.9rem 0 0.65rem;
    }

    .investment-grid {
        display: grid;
        gap: 0.7rem;
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .investment-card {
        background:
            radial-gradient(circle at top right, rgba(32, 199, 185, 0.16), transparent 38%),
            linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.035));
        border: 1px solid var(--tj-border);
        border-radius: 14px;
        box-shadow: 0 14px 34px rgba(0, 0, 0, 0.2);
        color: var(--tj-text);
        display: flex;
        flex-direction: column;
        min-height: 196px;
        padding: 0.72rem;
        text-decoration: none;
        transition: border-color 0.18s ease, transform 0.18s ease;
    }

    .investment-card.failed {
        background:
            radial-gradient(circle at top right, rgba(245, 193, 75, 0.09), transparent 34%),
            linear-gradient(180deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.032));
    }

    .failed-grid .investment-card {
        min-height: 188px;
    }

    .investment-card:hover {
        border-color: rgba(32, 199, 185, 0.44);
        color: var(--tj-text);
        transform: translateY(-2px);
    }

    .investment-card-head {
        align-items: flex-start;
        display: flex;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .investment-card h2 {
        font-size: 1.18rem;
        margin: 0;
    }

    .investment-card p {
        color: var(--tj-muted);
        font-size: 0.8rem;
        margin: 0.15rem 0 0;
    }

    .investment-score {
        align-items: center;
        background: rgba(245, 193, 75, 0.16);
        border: 1px solid rgba(245, 193, 75, 0.44);
        border-radius: 999px;
        color: #ffdd7a;
        display: inline-flex;
        font-size: 0.82rem;
        font-weight: 900;
        height: 38px;
        justify-content: center;
        min-width: 38px;
    }

    .investment-status {
        align-items: center;
        border-radius: 999px;
        display: inline-flex;
        font-size: 0.66rem;
        font-weight: 900;
        margin-top: 0.45rem;
        padding: 0.25rem 0.48rem;
        width: fit-content;
    }

    .investment-status.match {
        background: rgba(32, 199, 185, 0.17);
        border: 1px solid rgba(32, 199, 185, 0.42);
        color: #63fff1;
    }

    .investment-status.watch {
        background: rgba(245, 193, 75, 0.14);
        border: 1px solid rgba(245, 193, 75, 0.42);
        color: #ffdd7a;
    }

    .investment-card-meta {
        display: grid;
        gap: 0.38rem;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin: 0.55rem 0;
    }

    .investment-card-meta div {
        background: rgba(0, 0, 0, 0.18);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 9px;
        padding: 0.42rem;
    }

    .investment-card-meta strong {
        display: block;
        font-size: 0.78rem;
        margin-top: 0.2rem;
    }

    .investment-card .rationale {
        color: rgba(238, 242, 247, 0.82);
        font-size: 0.76rem;
        line-height: 1.35;
        margin-top: auto;
    }

    .investment-table {
        margin-top: 1rem;
        padding: 1.15rem 1.2rem 1.25rem;
    }

    .investment-table .panel-title {
        margin: 0 0 0.7rem;
    }

    .investment-table .table-responsive {
        min-width: 0;
        overflow-x: hidden;
        width: 100%;
    }

    .investment-table table {
        border-collapse: collapse;
        table-layout: fixed;
        width: 100%;
    }

    .investment-table th,
    .investment-table td {
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
        font-size: 0.78rem;
        line-height: 1.35;
        padding: 0.72rem 0.4rem;
        vertical-align: middle;
        white-space: normal;
        word-break: normal;
    }

    .investment-table th:nth-child(1),
    .investment-table td:nth-child(1) {
        width: 5%;
    }

    .investment-table th:nth-child(2),
    .investment-table td:nth-child(2) {
        width: 13%;
    }

    .investment-table th:nth-child(3),
    .investment-table td:nth-child(3),
    .investment-table th:nth-child(4),
    .investment-table td:nth-child(4),
    .investment-table th:nth-child(5),
    .investment-table td:nth-child(5),
    .investment-table th:nth-child(6),
    .investment-table td:nth-child(6),
    .investment-table th:nth-child(7),
    .investment-table td:nth-child(7),
    .investment-table th:nth-child(8),
    .investment-table td:nth-child(8),
    .investment-table th:nth-child(9),
    .investment-table td:nth-child(9) {
        width: 6.5%;
    }

    .investment-table th:nth-child(10),
    .investment-table td:nth-child(10) {
        width: 27%;
    }

    .investment-table th:nth-child(11),
    .investment-table td:nth-child(11) {
        text-align: right;
        width: 9.5%;
        word-break: break-word;
    }

    .investment-empty {
        padding: 2rem;
        text-align: center;
    }

    .investment-empty h2 {
        margin-bottom: 0.5rem;
    }

    .investment-disclaimer {
        color: var(--tj-muted);
        font-size: 0.85rem;
        margin: 1rem 0 0;
    }

    @@media (max-width: 1380px) {
        .investment-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 1200px) {
        .investment-content {
            grid-template-columns: 1fr;
        }

        .investment-side {
            order: -1;
            position: static;
        }

        .investment-rules {
            display: grid;
            gap: 1rem;
            grid-template-columns: minmax(220px, 0.75fr) minmax(0, 1.25fr);
        }

        .rules-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            margin-top: 0;
        }

        .investment-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .investment-summary {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .investment-toolbar {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 760px) {
        .investment-header {
            align-items: stretch;
            flex-direction: column;
        }

        .investment-grid,
        .investment-summary {
            grid-template-columns: 1fr;
        }

        .investment-rules,
        .rules-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@section Scripts {
    <script>
        (() => {
            const dataUrl = '@Url.Action("UnderEma200Data", "Investments")';
            const state = { items: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Items, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase })) };
            const currency = new Intl.NumberFormat('cs-CZ', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            const percent = new Intl.NumberFormat('cs-CZ', { minimumFractionDigits: 1, maximumFractionDigits: 1 });

            const elements = {
                qualifiedSummary: document.getElementById('emaQualifiedCount'),
                totalSummary: document.getElementById('emaTotalCount'),
                avgDistance: document.getElementById('emaAvgDistance'),
                updatedAt: document.getElementById('emaUpdatedAt'),
                source: document.getElementById('emaSource'),
                message: document.getElementById('emaMessage'),
                loading: document.getElementById('emaLoading'),
                qualifiedSection: document.getElementById('qualifiedSection'),
                failedSection: document.getElementById('failedSection'),
                qualifiedCards: document.getElementById('qualifiedCards'),
                failedCards: document.getElementById('failedCards'),
                qualifiedCount: document.getElementById('qualifiedCount'),
                failedCount: document.getElementById('failedCount'),
                empty: document.getElementById('emaEmpty'),
                rows: document.getElementById('emaRows'),
                tableWrap: document.getElementById('emaTableWrap'),
                tableCount: document.getElementById('emaTableCount'),
                search: document.getElementById('emaSearch'),
                sector: document.getElementById('emaSector'),
                sort: document.getElementById('emaSort'),
                refresh: document.getElementById('emaRefresh')
            };
            elements.timeframe = document.getElementById('emaTimeframe');
            elements.tableHeader = document.getElementById('emaTableHeader');
            elements.distanceLabel = document.getElementById('emaDistanceLabel');
            const getTimeframe = () => elements.timeframe.value || 'Weekly';
            const getEmaLabel = () => getTimeframe() === 'Weekly' ? 'Weekly EMA200' : 'Daily EMA200';

            const escapeHtml = (value) => String(value ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');

            const formatPrice = (value) => value == null ? '-' : currency.format(value);
            const formatPercent = (value) => value == null ? '-' : `${percent.format(value)} %`;
            const withSign = (value) => value > 0 ? `+${formatPercent(value)}` : formatPercent(value);

            function filteredItems() {
                const query = elements.search.value.trim().toLowerCase();
                const sector = elements.sector.value;
                const sort = elements.sort.value;

                const items = state.items.filter(item => {
                    const matchesQuery = !query ||
                        item.symbol.toLowerCase().includes(query) ||
                        item.name.toLowerCase().includes(query);
                    const matchesSector = !sector || item.sector === sector;
                    return matchesQuery && matchesSector;
                });

                return items.sort((a, b) => {
                    if (sort === 'distance') {
                        return b.distanceFromEmaPercent - a.distanceFromEmaPercent;
                    }

                    if (sort === 'fiveYear') {
                        return b.performance5YearPercent - a.performance5YearPercent;
                    }

                    return b.score - a.score;
                });
            }

            function renderSectorOptions() {
                const selected = elements.sector.value;
                const sectors = [...new Set(state.items.map(item => item.sector).filter(Boolean))].sort();
                elements.sector.innerHTML = '<option value="">Vsechny sektory</option>' +
                    sectors.map(sector => `<option value="${escapeHtml(sector)}">${escapeHtml(sector)}</option>`).join('');
                elements.sector.value = selected;
            }

            function renderCard(item) {
                return `
                    <a class="investment-card ${item.isQualified ? '' : 'failed'}" href="${escapeHtml(item.chartUrl)}" target="_blank" rel="noopener">
                        <div class="investment-card-head">
                            <div>
                                <h2>${escapeHtml(item.symbol)}</h2>
                                <p>${escapeHtml(item.name)}</p>
                                <span class="investment-status ${item.isQualified ? 'match' : 'watch'}">${item.isQualified ? 'Qualified candidate' : 'Failed growth filter'}</span>
                            </div>
                            <span class="investment-score">${item.score}/100</span>
                        </div>
                        <div class="investment-card-meta">
                            <div>
                                <span>Cena</span>
                                <strong>${formatPrice(item.currentPrice)}</strong>
                            </div>
                            <div>
                                <span>${escapeHtml(getEmaLabel())}</span>
                                <strong>${formatPrice(item.ema200)}</strong>
                            </div>
                            <div>
                                <span>Pod EMA</span>
                                <strong>${formatPercent(item.distanceFromEmaPercent)}</strong>
                            </div>
                        </div>
                        <div class="investment-card-meta">
                            <div>
                                <span>1Y</span>
                                <strong>${withSign(item.performance1YearPercent)}</strong>
                            </div>
                            <div>
                                <span>3Y</span>
                                <strong>${withSign(item.performance3YearPercent)}</strong>
                            </div>
                            <div>
                                <span>5Y</span>
                                <strong>${withSign(item.performance5YearPercent)}</strong>
                            </div>
                        </div>
                        <p class="rationale">${escapeHtml(item.rationale)}</p>
                    </a>
                `;
            }

            function render() {
                const items = filteredItems();
                const belowEma = items.filter(item => item.isBelowEma200);
                const qualified = belowEma.filter(item => item.isQualified);
                const failed = belowEma.filter(item => !item.isQualified);
                const avgDistance = belowEma.length
                    ? belowEma.reduce((sum, item) => sum + item.distanceFromEmaPercent, 0) / belowEma.length
                    : null;

                elements.qualifiedSummary.textContent = qualified.length;
                elements.totalSummary.textContent = items.length;
                elements.avgDistance.textContent = avgDistance === null ? '-' : formatPercent(avgDistance);
                elements.tableCount.textContent = `${items.length} ${items.length === 1 ? 'firma' : 'firem'}`;
                elements.qualifiedCount.textContent = qualified.length;
                elements.failedCount.textContent = failed.length;

                elements.qualifiedSection.hidden = qualified.length === 0;
                elements.failedSection.hidden = failed.length === 0;
                elements.tableWrap.hidden = items.length === 0;
                elements.empty.hidden = items.length > 0 || elements.loading.hidden === false;

                elements.qualifiedCards.innerHTML = qualified.map(renderCard).join('');
                elements.failedCards.innerHTML = failed.map(renderCard).join('');

                elements.rows.innerHTML = items.map(item => `
                    <tr>
                        <td><strong>${escapeHtml(item.symbol)}</strong></td>
                        <td>${escapeHtml(item.name)}</td>
                        <td>${formatPrice(item.currentPrice)}</td>
                        <td>${formatPrice(item.ema200)}</td>
                        <td>${formatPercent(item.distanceFromEmaPercent)}</td>
                        <td>${withSign(item.performance1YearPercent)}</td>
                        <td>${withSign(item.performance3YearPercent)}</td>
                        <td>${withSign(item.performance5YearPercent)}</td>
                        <td><strong>${item.score}/100</strong></td>
                        <td>${escapeHtml(item.isQualified ? 'Qualified' : (item.rejectionReason || item.failureReasons || '-'))}</td>
                        <td>${item.calculationDate ? new Date(item.calculationDate).toLocaleDateString('cs-CZ') : '-'}</td>
                    </tr>
                `).join('');
            }

            async function loadData(forceRefresh = false) {
                elements.loading.hidden = false;
                elements.qualifiedSection.hidden = true;
                elements.failedSection.hidden = true;
                elements.empty.hidden = true;
                elements.refresh.disabled = true;

                try {
                    const params = new URLSearchParams({ timeframe: getTimeframe() });
                    if (forceRefresh) {
                        params.set('refresh', 'true');
                    }
                    const url = `${dataUrl}?${params.toString()}`;
                    const response = await fetch(url, { headers: { 'Accept': 'application/json' } });
                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}`);
                    }

                    const data = await response.json();
                    state.items = data.items || [];
                    if (data.timeframe) {
                        elements.timeframe.value = data.timeframe;
                    }
                    elements.tableHeader.textContent = data.emaLabel || getEmaLabel();
                    elements.distanceLabel.textContent = `vuci ${data.emaLabel || getEmaLabel()}`;
                    elements.updatedAt.textContent = data.updatedAt || '-';
                    elements.source.textContent = state.items.length
                        ? [...new Set(state.items.map(item => item.dataSource).filter(Boolean))].join(' / ')
                        : 'Yahoo / Alpha / Stooq';
                    elements.message.textContent = data.message || 'Screening dokoncen.';
                    renderSectorOptions();
                    render();
                } catch {
                    state.items = [];
                    elements.updatedAt.textContent = 'chyba';
                    elements.message.textContent = 'Screening se ted nepodarilo nacist.';
                    render();
                } finally {
                    elements.loading.hidden = true;
                    elements.refresh.disabled = false;
                    elements.empty.hidden = state.items.length > 0;
                }
            }

            elements.search.addEventListener('input', render);
            elements.sector.addEventListener('change', render);
            elements.sort.addEventListener('change', () => {
                const url = new URL(window.location.href);
                url.searchParams.set('timeframe', getTimeframe());
                url.searchParams.set('sort', elements.sort.value);
                window.history.replaceState({}, '', url);
                render();
            });
            elements.timeframe.addEventListener('change', () => {
                const url = new URL(window.location.href);
                url.searchParams.set('timeframe', getTimeframe());
                if (elements.sort.value) {
                    url.searchParams.set('sort', elements.sort.value);
                }
                window.location.href = url.toString();
            });
            elements.refresh.addEventListener('click', () => loadData(true));
            const initialParams = new URLSearchParams(window.location.search);
            const initialSort = initialParams.get('sort');
            if (initialSort && [...elements.sort.options].some(option => option.value === initialSort)) {
                elements.sort.value = initialSort;
            }
            renderSectorOptions();
            elements.updatedAt.textContent = '@(Model.UpdatedAt is null ? "-" : Model.UpdatedAt.Value.ToString("dd.MM. HH:mm"))';
            elements.message.textContent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Message));
            elements.source.textContent = state.items.length
                ? [...new Set(state.items.map(item => item.dataSource).filter(Boolean))].join(' / ')
                : 'Yahoo / Alpha / Stooq';
            elements.loading.hidden = true;
            render();
            loadData(true);
        })();
    </script>
}
