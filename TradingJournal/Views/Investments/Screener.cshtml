@model int
@{
    ViewData["Title"] = "Akciový screener";
    ViewData["BodyClass"] = "journal-shell";
}
<link rel="stylesheet" href="~/css/screening.css" asp-append-version="true" />
<div class="screening-page" id="screening-app" data-base="@Url.Content("~/Screening")">
    @Html.AntiForgeryToken()
    <header class="screening-header"><div><span class="screening-eyebrow">INVESTIČNÍ VÝZKUM · @Model AKCIÍ</span><h1>Akciový screener</h1><p>Kvalita firmy, ocenění a kontext. Každé hodnocení má své důvody a zdroje.</p></div><div class="screening-actions"><a asp-controller="Investments" asp-action="Planner">Investiční plánovač ↗</a><button id="screen-refresh" type="button">Aktualizovat data</button><button id="screen-stop" type="button" hidden>Zastavit</button></div></header>
    <section class="screening-summary" aria-live="polite"><div><small>VE VÝBĚRU</small><strong id="screen-count">@Model</strong><span>napříč 12 skupinami</span></div><div><small>HODNOTITELNÉ</small><strong id="screen-rated">—</strong><span>fundamenty + min. 80 % pokrytí</span></div><div><small>POD FÉROVOU HODNOTOU</small><strong id="screen-discount">—</strong><span>pod základním scénářem DCF</span></div><div><small>DATOVÁ DISCIPLÍNA</small><strong>Zdroj → závěr</strong><span>chybějící údaje nejsou neutrální skóre</span></div></section>
    <div class="screening-macro" id="screen-macro">Makro: načítám uložená data…</div>
    <section class="screening-filters"><label>Hledat<input id="screen-search" type="search" placeholder="Ticker nebo firma" /></label><label>Sektor<select id="screen-sector"><option value="">Všechny sektory</option></select></label><label>Výběr<select id="screen-filter"><option value="all">Všechny akcie</option><option value="rated">S celkovým hodnocením</option><option value="discount">Sleva k férové hodnotě</option><option value="ema">Pod denní EMA200</option><option value="season">Kladná sezónnost</option></select></label><label>Řazení<select id="screen-sort"><option value="coverage">Pokrytí daty</option><option value="score">Celkové skóre</option><option value="discount">Sleva</option><option value="season">Sezónnost 63 dní</option><option value="symbol">Ticker</option></select></label><div class="screening-presets" role="group" aria-label="Rychlé filtry"><button type="button" data-preset="all" class="is-active">Vše</button><button type="button" data-preset="opportunity">Příležitosti</button><button type="button" data-preset="quality">Nejlepší kvalita</button><button type="button" data-preset="season">Silná sezónnost</button><button type="button" data-preset="complete">Kompletní data</button></div></section>
    <p id="screen-status" role="status">Načítám screening…</p>
    <p id="screen-schedule" role="status"></p>
    <div class="screening-table"><table><thead><tr><th>Akcie</th><th>Cena USD</th><th>Férová hodnota</th><th>Sleva</th><th>Kvalita</th><th>Makro</th><th>Sezónnost</th><th>Technika</th><th>Geopolitika</th><th>Analýzy</th><th>Skóre / pokrytí</th></tr></thead><tbody id="screen-rows"></tbody></table></div>
    <nav class="screening-pagination" aria-label="Stránkování akcií"><button type="button" id="screen-prev">← Předchozí</button><span id="screen-page"></span><button type="button" id="screen-next">Další →</button></nav>
    <details class="screening-method"><summary>Metodika a limity hodnocení</summary><p>Váhy: kvalita 25 %, ocenění 30 %, makro 15 %, sezónnost 10 %, technika 10 %, geopolitika 5 %, analýzy 5 %. Celkové skóre se zobrazí až s kvalitou, oceněním a alespoň 80 % pokrytí. Chybějící složky celkové skóre nezvyšují. Skóre není pravděpodobnost výnosu; váhy zatím nebyly historicky kalibrovány.</p><p>DCF je orientační model ročního cash flow CFO − capex. Banky a REIT nemají automatické ocenění. Model nezohledňuje budoucí ředění a financování; nejde o plnohodnotný analytický posudek. Ceny, sezónnost a fundamenty mají různá data platnosti. Cena starší než 7 dní nebo výkazy s obdobím starším než 460 dní nemohou vytvořit aktivní ocenění.</p><p>Sezónnost používá historii z Tradingu nebo novější souvislou historii poskytovatele, bez míchání cenových úrovní různých zdrojů. Ukazuje cenové výnosy bez dividend. Zdroje nemusí mít jednotné úpravy o korporátní akce; výsledky vyžadují kontrolu. Makro je omezená heuristika amerických výnosů a nezaměstnanosti. Geopolitiku a rozbory autorů doplň v detailu s odkazem; jejich platnost automaticky vyprší.</p></details>
    <dialog id="screen-detail"><div class="screening-dialog-header"><h2 id="detail-title"></h2><button type="button" id="detail-close" aria-label="Zavřít">✕</button></div><div id="detail-body"></div><div class="screening-actions"><button type="button" id="detail-refresh">Aktualizovat tuto akcii</button><button type="button" id="detail-research">Upravit vlastní výzkum</button></div><form id="research-form" hidden><h3>Vlastní výzkum</h3><p>Ukládá se pouze pro tvůj účet. Vyplněné výkazy mají přednost před automatickými; vymazáním je opět použiješ.</p><fieldset><legend>Roční výkazy · USD v absolutních jednotkách</legend><div class="research-fields" id="fundamental-fields"></div></fieldset><fieldset><legend>Zdrojované rozbory</legend><div id="evidence-fields"></div><button type="button" id="evidence-add">+ Přidat rozbor</button></fieldset><p id="research-error" role="alert"></p><button type="submit">Uložit a přepočítat</button></form></dialog>
</div>
@section Scripts { <script src="~/js/screening.js" asp-append-version="true"></script> }

