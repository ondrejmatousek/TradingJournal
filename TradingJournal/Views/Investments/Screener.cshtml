@model int
@{
    ViewData["Title"] = "Akciový screener";
    ViewData["BodyClass"] = "journal-shell";
}
<link rel="stylesheet" href="~/css/screening.css" asp-append-version="true" />
<div class="screening-page" id="screening-app" data-base="@Url.Content("~/Screening")">
    @Html.AntiForgeryToken()
    <header class="screening-header"><div class="screening-title"><span class="screening-eyebrow">INVESTIČNÍ VÝZKUM · @Model AKCIÍ</span><h1>Akciový screener</h1><p>Kvalita firmy, ocenění a kontext. Každé hodnocení má své důvody a zdroje.</p></div><div class="screening-actions"><a asp-controller="Investments" asp-action="Planner">Investiční plánovač ↗</a><button id="screen-refresh" type="button">↻ Aktualizovat</button><button id="screen-stop" type="button" hidden>Zastavit</button></div></header>
    <section class="screening-summary" aria-live="polite"><div><small>VE VÝBĚRU</small><strong id="screen-count">@Model</strong><span>napříč 12 skupinami</span></div><div><small>HODNOTITELNÉ</small><strong id="screen-rated">—</strong><span>fundamenty + min. 80 % pokrytí</span></div><div><small>POD FÉROVOU HODNOTOU</small><strong id="screen-discount">—</strong><span>pod základním scénářem DCF</span></div><div><small>DATOVÁ DISCIPLÍNA</small><strong>Zdroj → závěr</strong><span>chybějící údaje nejsou neutrální skóre</span></div></section>
    <section class="screening-method" id="price-lab" aria-labelledby="price-lab-title">
        <h2 id="price-lab-title">Za jakou cenu dává firma smysl?</h2>
        <p>Pět ziskových nefinančních firem s dostupnou historií výkazů. Odhad hodnoty, limit podle požadovaného výnosu a očekávání započtená v ceně. Vlastní předpoklady se ukládají pro tvůj účet.</p>
        <button type="button" id="price-lab-reload">Přepočítat z uložených dat</button> <button type="button" id="price-lab-refresh">Aktualizovat data pěti firem</button>
        <p id="price-lab-status" role="status">MSFT · META · CTAS · RSG · ZTS. Kontrola používá uložená data, jejich aktuálnost ověřuje před výpočtem.</p>
        <div class="screening-table"><table><thead><tr><th>Akcie / cena</th><th>Pásmo hodnoty DCF</th><th>Limit pro požadovaný výnos</th><th>Limit po rezervě</th><th>Růst vysvětlující cenu</th><th>Kontrola odhadu</th></tr></thead><tbody id="price-lab-rows"></tbody></table></div>
        <p>Pásmo tvoří scénáře, nikoli pravděpodobnostní interval. Požadovaný výnos je vstup výpočtu; skutečný výnos závisí na budoucím hospodaření a ceně prodeje.</p>
    </section>
    <dialog id="price-lab-dialog" aria-labelledby="price-lab-heading">
        <div class="screening-dialog-header"><h2 id="price-lab-heading">Ocenění firmy</h2><button type="button" id="price-lab-close" aria-label="Zavřít">✕</button></div>
        <div id="price-lab-analysis"></div>
        <form id="price-lab-form">
            <h3>Moje předpoklady</h3>
            <p>Prázdný růst, marže nebo beta ponechá historický model. Růst se vztahuje k prvnímu roku a postupně směřuje k terminálnímu růstu. Cílové EBIT marže firma dosáhne v desátém roce.</p>
            <div class="price-lab-fields">
                <label>Požadovaný roční výnos %<input name="requiredReturnPercent" type="number" min="4" max="30" step="0.1" required /></label>
                <label>Počáteční růst tržeb %<input name="growthPercent" type="number" min="-10" max="50" step="0.1" /></label>
                <label>Cílová EBIT marže %<input name="marginPercent" type="number" min="1" max="60" step="0.1" /></label>
                <label>Beta firmy<input name="beta" type="number" min="0.3" max="3" step="0.01" /></label>
                <label>EPS příštích 12 měsíců · USD<input name="forwardEps" type="number" min="0.0001" max="1000000" step="0.0001" /></label>
                <label>Zvolené srovnávací P/E<input name="referencePe" type="number" min="0.01" max="100" step="0.01" /></label>
                <label>HTTPS zdroj předpokladů<input name="sourceUrl" type="url" maxlength="2000" placeholder="https://…" /></label>
                <label>Datum publikace zdroje<input name="sourceDate" type="date" /></label>
            </div>
            <p>Vlastní výhled, beta a srovnávací ocenění potřebují zdroj a datum. EPS × P/E je samostatná kontrola; s DCF se automaticky neprůměruje.</p>
            <p id="price-lab-message" role="status"></p>
            <div class="screening-actions"><button type="submit" id="price-lab-save">Uložit a přepočítat</button><button type="button" id="price-lab-reset">Obnovit historický model a výnos 10 %</button></div>
        </form>
    </dialog>
    <section class="screening-toolbar" aria-label="Režim screeneru"><div class="screening-view-switch"><button type="button" class="is-active" data-preset="all">Deskriptivní</button><button type="button" data-preset="quality">Technická kvalita</button></div><div class="screening-chip-list" role="group" aria-label="Rychlé filtry"><button type="button" data-preset="all" class="is-active">Vše</button><button type="button" data-preset="opportunity">Příležitosti</button><button type="button" data-preset="quality">Nejlepší kvalita</button><button type="button" data-preset="complete">Kompletní data</button></div><button type="button" class="screening-filter-toggle" onclick="document.getElementById('screening-advanced-filters').toggleAttribute('hidden')">☷ Filtry</button></section>
    <section class="screening-filters" id="screening-advanced-filters"><label class="screen-search-field">Hledat<input id="screen-search" type="search" placeholder="⌕  Ticker nebo firma" /></label><label>Sektor<select id="screen-sector"><option value="">Všechny sektory</option></select></label><label>Výběr<select id="screen-filter"><option value="all">Všechny akcie</option><option value="candidate">Kandidát k prověření</option><option value="wait">Čekat na cenu / potvrzení</option><option value="risk">Zvýšené riziko</option><option value="missing">Chybí podklady</option><option value="rated">S celkovým hodnocením</option><option value="discount">Sleva k férové hodnotě</option><option value="ema">Pod denní EMA200</option></select></label><label>Řazení<select id="screen-sort"><option value="coverage">Pokrytí daty</option><option value="score">Celkové skóre</option><option value="discount">Sleva</option><option value="confidence">Kvalita dat</option><option value="upside">Potenciál</option><option value="symbol">Ticker</option></select></label><label>Min. sleva %<input id="screen-min-discount" type="number" min="0" max="200" step="1" placeholder="např. 20" /></label><label>Min. score<input id="screen-min-score" type="number" min="0" max="100" step="1" placeholder="např. 70" /></label><label>Min. kvalita dat<input id="screen-min-confidence" type="number" min="0" max="100" step="1" placeholder="např. 70" /></label></section>
    <p id="screen-status" role="status">Načítám screening…</p>
    <p id="screen-schedule" role="status"></p>
    <section class="screening-method">
        <button type="button" id="screen-audit">Změřit pokrytí všech akcií</button>
        <p id="screen-audit-status" role="status">Kontrola uložených podkladů bez nového stahování z burz. Chybějící data nejsou negativním hodnocením firmy.</p>
        <details id="screen-audit-result" hidden><summary>Audit po jednotlivých akciích</summary><div class="screening-table"><table><thead><tr><th>Akcie</th><th>Cena</th><th>Historie</th><th>Výkazy</th><th>Ocenění</th><th>Chyby zdrojů</th></tr></thead><tbody id="screen-audit-rows"></tbody></table></div></details>
    </section>
    <div class="screening-table"><table><thead><tr><th>Akcie</th><th>Cena USD</th><th>Férová hodnota</th><th>Sleva</th><th>Akce / zóna</th><th>Kvalita firmy</th><th>Důvěryhodnost podkladů</th></tr></thead><tbody id="screen-rows"></tbody></table></div>
    <nav class="screening-pagination" aria-label="Stránkování akcií"><button type="button" id="screen-prev">← Předchozí</button><span id="screen-page"></span><button type="button" id="screen-next">Další →</button></nav>
    <details class="screening-method"><summary>Jak číst hodnocení a metodika</summary><p>Hlavní tabulka zobrazuje pouze rozhodovací výsledek. Kvalita firmy, ocenění a načasování tvoří investiční skóre. Makro, geopolitika a zdrojované analýzy zůstávají kontextem v detailu akcie a samostatné makro skóre výsledek uměle nezvyšuje ani nesnižuje.</p><p>Aktuální model ValuationV2.0 oceňuje provozní cash flow firmy v pesimistickém, základním a optimistickém scénáři. Přesné předpoklady a zdroje jsou v auditu ocenění. Kandidát k prověření potřebuje dostatečně důvěryhodné podklady, kvalitu firmy alespoň 60/100, kladný zisk, FCF a vlastní kapitál, přijatelnou cenu a potvrzení stabilizace. Banky a REIT vyžadují samostatný model. Chybějící ocenění samo o sobě neznamená špatnou firmu.</p><p>Screener používá nejvýše 252 posledních cen na ticker. Makro a geopolitika se používají jako kontext a jako vstupy ocenění, nikoli jako samostatné doporučení.</p></details>
    <dialog id="screen-detail"><div class="screening-dialog-header"><h2 id="detail-title"></h2><button type="button" id="detail-close" aria-label="Zavřít">✕</button></div><div id="detail-body"></div><div class="screening-actions"><button type="button" id="detail-refresh">Aktualizovat tuto akcii</button><button type="button" id="detail-research">Upravit vlastní výzkum</button></div><form id="research-form" hidden><h3>Vlastní výzkum</h3><p>Ukládá se pouze pro tvůj účet. Vyplněné výkazy mají přednost před automatickými; vymazáním je opět použiješ.</p><fieldset><legend>Roční výkazy · USD v absolutních jednotkách</legend><div class="research-fields" id="fundamental-fields"></div></fieldset><fieldset><legend>Zdrojované rozbory</legend><div id="evidence-fields"></div><button type="button" id="evidence-add">+ Přidat rozbor</button></fieldset><p id="research-error" role="alert"></p><button type="submit">Uložit a přepočítat</button></form></dialog>
</div>
@section Scripts { <script src="~/js/screening.js" asp-append-version="true"></script><script src="~/js/price-lab.js" asp-append-version="true"></script> }
