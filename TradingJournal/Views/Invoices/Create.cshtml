@model TradingJournal.ViewModels.InvoiceFormViewModel
@using TradingJournal.Models
@using System.Globalization
@using System.Text.Json

@{
    var isEdit = Model.Id.HasValue;
    var formAction = ViewData["FormAction"] as string ?? "Create";
    ViewData["Title"] = isEdit ? "Upravit fakturu" : "Nová faktura";
    ViewData["BodyClass"] = "journal-shell";
    var isTimesheetImport = ViewData["IsTimesheetImport"] as bool? == true;
    var timesheetHoursTotal = Model.Items.Sum(i => i.Quantity);
}

<div class="journal-page">
    <div class="container-lg">
        <div class="journal-header compact">
            <div>
                <div class="eyebrow">Invoice builder</div>
                <h1>@(isEdit ? "Upravit fakturu" : "Nová faktura")</h1>
                <p>Vyber firmy, uprav položky a ulož fakturu.</p>
            </div>
            <div class="page-actions">
                <a asp-action="Companies" class="btn btn-outline-secondary">Firmy</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Zpět</a>
            </div>
        </div>

        @if (ViewData["ImportNotice"] is string notice)
        {
            <div class="alert alert-info">@notice</div>
        }

        @if (!Model.SupplierOptions.Any())
        {
            <div class="alert alert-warning">
                Nejdřív vytvoř alespoň jednu firmu. Ideálně označ svoji firmu jako výchozího dodavatele.
                <a asp-action="CreateCompany">Vytvořit firmu</a>
            </div>
        }

        <div class="app-card form-card">
            <div class="card-body">
                <form asp-action="@formAction" asp-route-id="@Model.Id" method="post" id="invoiceForm">
                    <input asp-for="Id" type="hidden" />
                    <input asp-for="InvoiceNumber" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="Currency" class="form-label">Měna</label>
                            <input asp-for="Currency" class="form-control" maxlength="3" />
                            <span asp-validation-for="Currency" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SupplierCompanyId" class="form-label">Kdo fakturuje</label>
                            <select asp-for="SupplierCompanyId" asp-items="Model.SupplierOptions" class="form-select">
                                <option value="">Vyber dodavatele</option>
                            </select>
                            <span asp-validation-for="SupplierCompanyId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CustomerCompanyId" class="form-label">Komu fakturuji</label>
                            <select asp-for="CustomerCompanyId" asp-items="Model.CustomerOptions" class="form-select">
                                <option value="">Vyber odběratele</option>
                            </select>
                            <span asp-validation-for="CustomerCompanyId" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="IssueDate" class="form-label">Datum vystavení</label>
                            <input asp-for="IssueDate" type="date" class="form-control" />
                            <span asp-validation-for="IssueDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DueDate" class="form-label">Datum splatnosti</label>
                            <input asp-for="DueDate" type="date" class="form-control" />
                            <span asp-validation-for="DueDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 @(Model.IsSupplierVatPayer ? "" : "d-none")" data-vat-only>
                            <label asp-for="TaxableSupplyDate" class="form-label">DUZP</label>
                            <input asp-for="TaxableSupplyDate" type="date" class="form-control" />
                            <span asp-validation-for="TaxableSupplyDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="invoice-builder mt-4">
                        <div class="invoice-builder-head">
                            <div>
                                <h2>Položky faktury</h2>
                                <span>@(isTimesheetImport ? "Import je připravený jako upravitelný přehled schválených hodin." : "Řádky můžeš přidávat ručně nebo je předvyplnit importem z Excelu.")</span>
                            </div>
                            @if (!isTimesheetImport)
                            {
                                <button type="button" class="btn btn-outline-secondary btn-sm" id="addInvoiceItem">Přidat položku</button>
                            }
                        </div>

                        @if (isTimesheetImport)
                        {
                            <div class="timesheet-import-table" id="invoiceItems">
                                <div class="timesheet-import-head">
                                    <span>Datum</span>
                                    <span>Hodiny</span>
                                    <span>Status</span>
                                </div>

                                @for (var i = 0; i < Model.Items.Count; i++)
                                {
                                    <div class="timesheet-import-row invoice-item-input">
                                        <input asp-for="Items[i].Description" class="form-control" />
                                        <input asp-for="Items[i].Quantity" class="form-control timesheet-hours-input" inputmode="decimal" />
                                        <span class="status-pill approved">Approved</span>
                                        <input asp-for="Items[i].Unit" type="hidden" />
                                        <input asp-for="Items[i].UnitPrice" type="hidden" />
                                        <input asp-for="Items[i].VatRate" type="hidden" />
                                        <span asp-validation-for="Items[i].Description" class="text-danger grid-validation"></span>
                                    </div>
                                }

                                <div class="timesheet-import-total">
                                    <span>Součet schválených hodin</span>
                                    <div class="timesheet-total-edit">
                                        <input asp-for="TotalHoursOverride" id="timesheetHoursTotalInput" class="form-control" inputmode="decimal" value="@timesheetHoursTotal.ToString("N2", CultureInfo.GetCultureInfo("cs-CZ"))" />
                                        <strong>hod</strong>
                                    </div>
                                    <span asp-validation-for="TotalHoursOverride" class="text-danger"></span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="invoice-form-grid invoice-form-grid-head @(Model.IsSupplierVatPayer ? "vat-enabled" : "no-vat")">
                                <span>Popis</span>
                                <span>Množství</span>
                                <span>MJ</span>
                                <span>Cena</span>
                                <span data-vat-only class="@(Model.IsSupplierVatPayer ? "" : "d-none")">DPH %</span>
                                <span></span>
                            </div>

                            <div id="invoiceItems">
                                @for (var i = 0; i < Model.Items.Count; i++)
                                {
                                    <div class="invoice-form-grid invoice-item-input @(Model.IsSupplierVatPayer ? "vat-enabled" : "no-vat")">
                                        <input asp-for="Items[i].Description" class="form-control" placeholder="Např. Konzultace, správa portfolia..." />
                                        <input asp-for="Items[i].Quantity" class="form-control" inputmode="decimal" />
                                        <input asp-for="Items[i].Unit" class="form-control" />
                                        <input asp-for="Items[i].UnitPrice" class="form-control" inputmode="decimal" />
                                        <input asp-for="Items[i].VatRate" class="form-control @(Model.IsSupplierVatPayer ? "" : "d-none")" inputmode="decimal" data-vat-only />
                                        <button type="button" class="btn btn-outline-danger btn-sm remove-invoice-item">Odebrat</button>
                                        <span asp-validation-for="Items[i].Description" class="text-danger grid-validation"></span>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="mt-4">
                        <label asp-for="Notes" class="form-label">Poznámka</label>
                        <textarea asp-for="Notes" class="form-control journal-textarea" rows="4" placeholder="Volitelná poznámka na fakturu nebo interní kontext."></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Uložit fakturu</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Zrušit</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<template id="invoiceItemTemplate">
    <div class="invoice-form-grid invoice-item-input vat-enabled">
        <input name="Items[__index__].Description" class="form-control" placeholder="Popis položky" />
        <input name="Items[__index__].Quantity" class="form-control" inputmode="decimal" value="1" />
        <input name="Items[__index__].Unit" class="form-control" value="ks" />
        <input name="Items[__index__].UnitPrice" class="form-control" inputmode="decimal" value="0" />
        <input name="Items[__index__].VatRate" class="form-control" inputmode="decimal" value="21" data-vat-only />
        <button type="button" class="btn btn-outline-danger btn-sm remove-invoice-item">Odebrat</button>
    </div>
</template>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/invoices.js" asp-append-version="true"></script>
    <script>
        (() => {
            const supplier = document.getElementById('SupplierCompanyId');
            const customer = document.getElementById('CustomerCompanyId');
            const vatPayers = @Html.Raw(JsonSerializer.Serialize(Model.SupplierVatPayerOptions));
            const customerDescriptions = @Html.Raw(JsonSerializer.Serialize(Model.CustomerInvoiceDescriptions));
            const customerDefaultPrices = @Html.Raw(JsonSerializer.Serialize(Model.CustomerInvoiceDefaultPrices));
            let automaticDescription = null;
            let automaticPrice = null;
            if (!supplier || !customer) {
                return;
            }

            function syncCustomerOptions() {
                const supplierValue = supplier.value;
                [...customer.options].forEach(option => {
                    if (!option.value) {
                        return;
                    }

                    const isSelf = option.value === supplierValue;
                    option.hidden = isSelf;
                    option.disabled = isSelf;
                });

                if (customer.value === supplierValue) {
                    customer.value = '';
                }
            }

            function syncVatFields() {
                const isVatPayer = supplier.value && vatPayers[supplier.value] === true;
                document.querySelectorAll('[data-vat-only]').forEach(element => {
                    const isInput = element.matches('input');
                    element.classList.toggle('d-none', !isVatPayer);
                    if (isInput) {
                        element.disabled = !isVatPayer;
                        element.tabIndex = isVatPayer ? 0 : -1;
                        if (!isVatPayer) element.value = '0';
                        else if (!element.value || element.value === '0') element.value = '21';
                    }
                });
                document.querySelectorAll('.invoice-form-grid').forEach(grid => grid.classList.toggle('no-vat', !isVatPayer));
            }

            function syncCustomerDefaults() {
                const row = document.querySelector('#invoiceItems .invoice-item-input');
                if (!row) return;

                const description = row.querySelector('[name$=".Description"]');
                const price = row.querySelector('[name$=".UnitPrice"]');
                if (!description || !price) return;

                if (automaticDescription !== null && description.value === automaticDescription && !customerDescriptions[customer.value]) {
                    description.value = '';
                }
                if (automaticPrice !== null && price.value === automaticPrice && !customerDefaultPrices[customer.value]) {
                    price.value = '0';
                }

                automaticDescription = null;
                automaticPrice = null;
                const selectedCustomerName = customer.options[customer.selectedIndex]?.textContent || '';
                const normalizedCustomerName = selectedCustomerName.replace(/[^\p{L}\p{N}]/gu, '').toLowerCase();
                const isTeamDelivery = normalizedCustomerName.includes('teamdeliverysolution');
                const defaultDescription = customerDescriptions[customer.value] || (isTeamDelivery ? 'expertní vývojové práce MS .NET' : null);
                const defaultPrice = customerDefaultPrices[customer.value] || (isTeamDelivery ? 750 : null);
                const normalizedPrice = (price.value || '').replace(/\s/g, '').replace(',', '.');
                const hasZeroPrice = !normalizedPrice || Number.parseFloat(normalizedPrice) === 0;
                if (defaultDescription && !description.value.trim()) {
                    description.value = defaultDescription;
                    automaticDescription = defaultDescription;
                }
                if (defaultPrice && hasZeroPrice) {
                    price.value = Number(defaultPrice).toLocaleString('cs-CZ', { useGrouping: false, maximumFractionDigits: 2 });
                    automaticPrice = price.value;
                }
            }

            supplier.addEventListener('change', syncCustomerOptions);
            supplier.addEventListener('change', syncVatFields);
            customer.addEventListener('change', syncCustomerDefaults);
            syncCustomerOptions();
            syncVatFields();
            syncCustomerDefaults();
        })();
    </script>
}
