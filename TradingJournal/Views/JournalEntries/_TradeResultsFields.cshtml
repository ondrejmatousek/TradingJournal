@model TradingJournal.Models.JournalEntry
@using TradingJournal.Models

<div class="col-md-6 trade-closed-field">
    <label asp-for="ProfitLoss" class="form-label">Zisk / ztráta (částka)</label>
    <input asp-for="ProfitLoss" type="text" class="form-control" inputmode="decimal" data-val="false" placeholder="Např. 250,50 nebo -125,00" />
    <div class="form-text">Čistý výsledek po poplatcích v měně účtu. V deníku používej stejnou měnu. Prázdné = nezadáno.</div>
    <span asp-validation-for="ProfitLoss" class="text-danger"></span>
</div>
<div class="col-md-6 trade-closed-field" data-planned-outcome>
    <label asp-for="PlannedOutcome" class="form-label">Jak by dopadl původní plán?</label>
    <select asp-for="PlannedOutcome" asp-items="Html.GetEnumSelectList<PlannedTradeOutcome>()" class="form-select">
        <option value="">Nezjištěno / zatím nevím</option>
    </select>
    <div class="form-text">Pro BE a ruční uzavření: zpětně označ, zda by byl dosažen původní TP nebo SL.</div>
    <span asp-validation-for="PlannedOutcome" class="text-danger"></span>
</div>
<div class="col-md-6">
    <label asp-for="SeasonalityAligned" class="form-label">Seděla sezónnost se směrem obchodu?</label>
    <select asp-for="SeasonalityAligned" class="form-select">
        <option value="">Nezjištěno</option>
        <option value="true">Ano</option>
        <option value="false">Ne</option>
    </select>
    <span asp-validation-for="SeasonalityAligned" class="text-danger"></span>
</div>
