@model TradingJournal.Models.InvoiceCompany

@{
    ViewData["Title"] = "Smazat firmu";
    ViewData["BodyClass"] = "journal-shell";
    var isUsed = ViewData["IsUsed"] as bool? == true;
}

<div class="journal-page">
    <div class="container-lg">
        <div class="row justify-content-center">
            <div class="col-xl-8">
                <div class="journal-header compact">
                    <div>
                        <div class="eyebrow">Company delete</div>
                        <h1>Smazat firmu</h1>
                        <p>@Model.Name</p>
                    </div>
                    <a asp-action="Companies" class="btn btn-outline-secondary">Zpět</a>
                </div>

                <div class="app-card form-card">
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        @if (isUsed)
                        {
                            <div class="alert alert-warning">
                                Tuhle firmu nejde smazat, protože už je použitá na faktuře. Můžeš ji jen editovat.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-danger">
                                Opravdu chceš smazat firmu <strong>@Model.Name</strong>?
                            </div>
                        }

                        <div class="company-meta mb-4">
                            <span>IČO @(Model.RegistrationNumber ?? "-")</span>
                            <span>DIČ @(Model.TaxNumber ?? "-")</span>
                            <span>@Model.Street, @Model.ZipCode @Model.City</span>
                        </div>

                        <form asp-action="DeleteCompany" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger" disabled="@isUsed">Smazat firmu</button>
                            <a asp-action="Companies" class="btn btn-outline-secondary">Zrušit</a>
                            @if (isUsed)
                            {
                                <a asp-action="EditCompany" asp-route-id="@Model.Id" class="btn btn-primary">Editovat</a>
                            }
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
