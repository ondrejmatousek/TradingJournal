@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isTradingSection = controller is "TradingJournals" or "JournalEntries";
    var currentJournal = ViewData["CurrentJournal"] as TradingJournal.Models.TradingJournalBook;
    var isInvestmentSection = controller is "Investments" or "Screening" or "Insiders";
}
                @if (isTradingSection)
                {
                    <div class="sidebar-title">Trading</div>
                    <a class="sidebar-link @(controller == "TradingJournals" ? "active" : "")" asp-controller="TradingJournals" asp-action="Index">Moje deníky</a>
                    @if (currentJournal is not null)
                    {
                        <div class="sidebar-title text-break">@currentJournal.Name</div>
                        <a class="sidebar-link @(action == "Index" ? "active" : "")" asp-route="journal" asp-route-journalId="@currentJournal.Id" asp-route-action="Index">Obchody a kalendář</a>
                        <a class="sidebar-link @(action == "Analysis" ? "active" : "")" asp-route="journal" asp-route-journalId="@currentJournal.Id" asp-route-action="Analysis">Analýza deníku</a>
                    }
                    <div class="sidebar-title">Společné nástroje</div>
                    <a class="sidebar-link @(controller == "JournalEntries" && action == "Strategy" ? "active" : "")" asp-controller="JournalEntries" asp-action="Strategy">Strategie</a>
                    <a class="sidebar-link @(controller == "JournalEntries" && action == "SetupReview" ? "active" : "")" asp-controller="JournalEntries" asp-action="SetupReview">Setup Review</a>
                    <a class="sidebar-link @(controller == "JournalEntries" && action == "TradeQuality" ? "active" : "")" asp-controller="JournalEntries" asp-action="TradeQuality">Kvalita tradu</a>
                }
                else if (isInvestmentSection)
                {
                    <div class="sidebar-title">Investování</div>
                    <a class="sidebar-link @(action == "Planner" ? "active" : "")" asp-controller="Investments" asp-action="Planner">Investiční plánovač</a>
                    <a class="sidebar-link @(controller == "Screening" ? "active" : "")" asp-controller="Screening" asp-action="Index">Akciový screener</a>
                    <a class="sidebar-link @(controller == "Insiders" ? "active" : "")" asp-controller="Insiders" asp-action="Index">Insiders</a>
                }
