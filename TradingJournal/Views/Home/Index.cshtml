@model TradingJournal.ViewModels.HomeIndexViewModel
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = "EdgeDesk";
    ViewData["BodyClass"] = "marketing-shell";
}

<section class="hero-stage">
    <div class="hero-copy">
        <div class="home-command-card">
            <div class="home-command-brand">
                <span class="brand-mark">ED</span>
                <strong>EdgeDesk</strong>
            </div>

            <div class="home-command-actions">
                @if (SignInManager.IsSignedIn(User))
                {
                    <a asp-controller="JournalEntries" asp-action="Index" class="home-action primary">Journal</a>
                    <a asp-controller="JournalEntries" asp-action="Analysis" class="home-action">Analyza</a>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login" class="home-action primary">Sign in</a>
                    <a asp-area="Identity" asp-page="/Account/Register" class="home-action">Create account</a>
                }
            </div>

            <div class="home-mini-stats" aria-label="Quick overview">
                <div>
                    <span>Focus</span>
                    <strong>XAU / NQ / BTC</strong>
                </div>
                <div>
                    <span>Session</span>
                    <strong>Daily</strong>
                </div>
            </div>
        </div>
    </div>

    <div class="hero-visual">
        <div class="daily-bias-panel">
            <div class="daily-bias-head">
                <div>
                    <span>Market bias</span>
                    <strong>XAU &middot; NQ &middot; BTC</strong>
                </div>
                <small>
                    @(Model.MarketBiasUpdatedAt.HasValue
                        ? Model.MarketBiasUpdatedAt.Value.ToLocalTime().ToString("dd.MM. HH:mm")
                        : "today")
                </small>
                <form asp-controller="Home" asp-action="RefreshMarketBias" method="post" class="bias-refresh-form">
                    <button type="submit" class="bias-refresh-button">Refresh</button>
                </form>
            </div>

            @if (Model.MarketBiases.Any())
            {
                <div class="bias-card-grid">
                    @foreach (var bias in Model.MarketBiases)
                    {
                        var directionClass = bias.Direction.ToLowerInvariant();
                        <article class="bias-card @directionClass">
                            <button class="bias-card-button" type="button" aria-label="@bias.Symbol market bias">
                                <span class="bias-card-top">
                                    <span>
                                        <strong>@bias.Symbol</strong>
                                        <small>@bias.DisplayName</small>
                                    </span>
                                    <em>@bias.Direction</em>
                                </span>

                                <span class="bias-stars" aria-label="@bias.ConfidenceStars stars">
                                    @for (var star = 1; star <= 5; star++)
                                    {
                                        <span class="@(star <= bias.ConfidenceStars ? "active" : "")">&#9733;</span>
                                    }
                                </span>

                                <span class="bias-summary">@bias.Summary</span>

                                <span class="bias-metrics">
                                    <span>Score <strong>@bias.SignalScore.ToString("+#;-#;0")</strong></span>
                                    @if (bias.ChangePercent.HasValue)
                                    {
                                        <span>Day <strong>@bias.ChangePercent.Value.ToString("+#.##;-#.##;0")%</strong></span>
                                    }
                                    @if (bias.Rsi14.HasValue)
                                    {
                                        <span>RSI <strong>@bias.Rsi14.Value.ToString("0.#")</strong></span>
                                    }
                                </span>

                                <span class="bias-bullets">
                                    @foreach (var bullet in bias.Bullets.Take(1))
                                    {
                                        <span>@bullet</span>
                                    }
                                </span>
                            </button>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="bias-empty">Bias se nacte po startu aplikace.</div>
            }

            <div class="bias-disclaimer">
                Technicky kontext, ne financni doporuceni.
            </div>
        </div>

        <div class="stock-radar-panel">
            <div class="stock-radar-head">
                <div>
                    <span>Stock radar</span>
                    <strong>Undervalued watch</strong>
                </div>
                <small>
                    @(Model.StockRadarUpdatedAt.HasValue
                        ? Model.StockRadarUpdatedAt.Value.ToLocalTime().ToString("dd.MM. HH:mm")
                        : "setup")
                </small>
            </div>

            @if (Model.StockIdeas.Any())
            {
                <div class="stock-idea-list">
                    @foreach (var idea in Model.StockIdeas)
                    {
                        <article class="stock-idea">
                            <div>
                                <strong>@idea.Symbol</strong>
                                <span>@idea.Name</span>
                            </div>
                            <em>@idea.Score/7</em>
                            <div class="stock-idea-metrics">
                                @if (idea.TargetUpsidePercent.HasValue)
                                {
                                    <span>Upside <strong>@idea.TargetUpsidePercent.Value.ToString("+#.#;-#.#;0")%</strong></span>
                                }
                                @if (idea.PeRatio.HasValue)
                                {
                                    <span>P/E <strong>@idea.PeRatio.Value.ToString("0.#")</strong></span>
                                }
                                @if (idea.PegRatio.HasValue)
                                {
                                    <span>PEG <strong>@idea.PegRatio.Value.ToString("0.##")</strong></span>
                                }
                            </div>
                            @foreach (var reason in idea.Reasons.Take(1))
                            {
                                <p>@reason</p>
                            }
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="stock-radar-empty">
                    @Model.StockRadarMessage
                </div>
            }
        </div>

    </div>
</section>
