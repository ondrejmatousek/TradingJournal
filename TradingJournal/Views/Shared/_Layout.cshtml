@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    var bodyClass = ViewData["BodyClass"] as string ?? string.Empty;
    var isFullBleed = bodyClass.Contains("marketing-shell") || bodyClass.Contains("auth-shell") || bodyClass.Contains("journal-shell");
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var isTradingSection = controller == "TradingJournals" || controller == "JournalEntries" || controller == "Cot" || controller == "Seasonality";
    var isInvestmentSection = controller == "Investments" || controller == "Screening" || controller == "Insiders";
    var showSidebar = SignInManager.IsSignedIn(User) && !bodyClass.Contains("marketing-shell") && !bodyClass.Contains("auth-shell") && (isTradingSection || isInvestmentSection);
}

<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EdgeDesk</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TradingJournal.styles.css" asp-append-version="true" />
</head>
<body class="@($"{bodyClass} {(showSidebar ? "app-section-shell" : string.Empty)}".Trim())">
    <header>
        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="container-fluid">
                <a class="navbar-brand app-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">ED</span>
                    <span>EdgeDesk</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#app-navigation" aria-controls="app-navigation"
                        aria-expanded="false" aria-label="Otevřít nebo zavřít menu">
                    <span class="app-menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
                </button>
                <div id="app-navigation" class="navbar-collapse collapse justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(isTradingSection ? "active" : "")" asp-controller="TradingJournals" asp-action="Index">Trading Journal</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isInvestmentSection ? "active" : "")" asp-controller="Screening" asp-action="Index">Investování</a>
                            </li>
                        }
                    </ul>
                    @if (showSidebar)
                    {
                        <div class="app-mobile-sections"><partial name="_SectionNavigation" /></div>
                    }
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="@(showSidebar ? "app-workspace" : isFullBleed ? "app-fullbleed" : "container")">
        @if (showSidebar)
        {
            <aside class="app-sidebar">
                <partial name="_SectionNavigation" />
            </aside>
        }
        <main role="main" class="@(showSidebar ? "app-workspace-main" : "pb-3")">
                @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted @((isFullBleed || showSidebar) ? "d-none" : "border-top")">
        <div class="container">
            &copy; 2026 - EdgeDesk - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/cot-chart.js" asp-append-version="true"></script>
    <script src="~/js/cot-page-refresh.js" asp-append-version="true"></script>
    <script src="~/js/seasonality-geometry.js" asp-append-version="true"></script>
    <script src="~/js/seasonality.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
