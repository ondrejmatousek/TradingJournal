@model TradingJournal.Models.Invoice

@{
    var variableSymbol = VariableSymbol(Model.InvoiceNumber);
    ViewData["Title"] = "Smazat fakturu";
    ViewData["BodyClass"] = "journal-shell";
}

<div class="journal-page">
    <div class="journal-wrap">
        <div class="journal-header compact">
            <div>
                <div class="eyebrow">Delete invoice</div>
                <h1>Smazat fakturu?</h1>
                <p>Faktura @variableSymbol pro @Model.CustomerCompany?.Name bude trvale odstraněna.</p>
            </div>
            <div class="page-actions">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Zpět</a>
            </div>
        </div>

        <div class="app-card form-card">
            <div class="card-body">
                <div class="alert alert-warning mb-4">
                    Opravdu chceš tuto fakturu smazat? Tuto akci nejde vrátit zpět.
                </div>

                <div class="invoice-summary-lines mb-4">
                    <div><span>Variabilní symbol</span><strong>@variableSymbol</strong></div>
                    <div><span>Odběratel</span><strong>@Model.CustomerCompany?.Name</strong></div>
                    <div class="total"><span>Celkem</span><strong>@Model.TotalGross.ToString("N2") @Model.Currency</strong></div>
                </div>

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                    <button type="submit" class="btn btn-outline-danger">Ano, smazat</button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Nechat fakturu</a>
                </form>
            </div>
        </div>
    </div>
</div>

@functions {
    private static string VariableSymbol(string? invoiceNumber)
    {
        var digits = new string((invoiceNumber ?? string.Empty).Where(char.IsDigit).ToArray());
        return string.IsNullOrWhiteSpace(digits) ? invoiceNumber ?? string.Empty : digits;
    }
}
