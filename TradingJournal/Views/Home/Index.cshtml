@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = "EdgeDesk";
    ViewData["BodyClass"] = "marketing-shell";
}

<section class="hero-stage">
    <div class="hero-copy">
        <div class="eyebrow">EdgeDesk trading journal</div>
        <h1>The journal that shows what your trading is really doing.</h1>
        <p>
            Track execution, review discipline, compare setups, and turn every trade into
            cleaner feedback for the next session.
        </p>

        <div class="hero-actions">
            @if (SignInManager.IsSignedIn(User))
            {
                <a asp-controller="JournalEntries" asp-action="Index" class="btn btn-primary hero-primary">Open Journal</a>
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary hero-primary">Sign in</a>
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-dark hero-secondary">Create account</a>
            }
        </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
        <div class="terminal-panel">
            <div class="terminal-topline">
                <span>Session Review</span>
                <span class="text-teal">+2.6R</span>
            </div>
            <div class="mini-chart">
                <span style="height: 22%"></span>
                <span style="height: 36%"></span>
                <span style="height: 30%"></span>
                <span style="height: 52%"></span>
                <span style="height: 49%"></span>
                <span style="height: 72%"></span>
                <span style="height: 62%"></span>
                <span style="height: 85%"></span>
            </div>
            <div class="review-note">
                <strong>Process insight</strong>
                <span>Best results came from trades where the plan was followed before entry.</span>
            </div>
        </div>

        <div class="calendar-panel">
            <div class="panel-title">
                <span>May Performance</span>
                <strong>68% win rate</strong>
            </div>
            <div class="trade-calendar">
                @{
                    var days = new[]
                    {
                        ("26", ""), ("27", "win"), ("28", ""), ("29", ""), ("30", "loss"), ("31", ""),
                        ("1", ""), ("2", "loss"), ("3", "win"), ("4", "win"), ("5", ""), ("6", ""),
                        ("7", ""), ("8", "win"), ("9", ""), ("10", "loss"), ("11", "win"), ("12", ""),
                        ("13", ""), ("14", ""), ("15", "win"), ("16", ""), ("17", "win"), ("18", "")
                    };
                }
                @foreach (var day in days)
                {
                    <div class="calendar-day @day.Item2">
                        <span>@day.Item1</span>
                        @if (day.Item2 == "win")
                        {
                            <strong>+$215</strong>
                        }
                        else if (day.Item2 == "loss")
                        {
                            <strong>-$97</strong>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="trade-ticket">
            <div class="ticket-header">
                <span>XAUUSD</span>
                <strong>Long</strong>
            </div>
            <div class="ticket-row">
                <span>Risk</span>
                <strong>1.00%</strong>
            </div>
            <div class="ticket-row">
                <span>Plan</span>
                <strong class="text-teal">Followed</strong>
            </div>
        </div>
    </div>
</section>

<section class="feature-strip">
    <div>
        <strong>Review discipline</strong>
        <span>Separate process quality from outcome noise.</span>
    </div>
    <div>
        <strong>Find weak setups</strong>
        <span>Filter by asset, side, result, and plan adherence.</span>
    </div>
    <div>
        <strong>Trade with memory</strong>
        <span>Screenshots, notes, emotions, and repeatable insights.</span>
    </div>
</section>
