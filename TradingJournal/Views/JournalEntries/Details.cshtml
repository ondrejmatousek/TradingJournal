@model TradingJournal.Models.JournalEntry
@using TradingJournal.Models

@{
    ViewData["Title"] = "Journal entry";
    ViewData["BodyClass"] = "journal-shell";

    var entryLocal = Model.EntryTime?.LocalDateTime;
    string outcomeClass = Model.Outcome switch
    {
        TradeOutcome.Win => "badge-win",
        TradeOutcome.Loss => "badge-loss",
        TradeOutcome.Breakeven => "badge-neutral",
        _ => "badge-muted"
    };
}

<div class="journal-page">
<partial name="_JournalBreadcrumb" />

    <div class="journal-wrap">
        <div class="journal-header">
            <div>
                <div class="eyebrow">Trade review</div>
                <h1>@Model.Asset</h1>
                <p>Created @Model.CreatedAt.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</p>
            </div>

            <div class="page-actions">
                <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete</a>
            </div>
        </div>

        <div class="detail-grid">
            <section class="app-card trade-summary">
                <div class="trade-card-header">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="badge badge-side">@Model.Side</span>
                        <span class="badge @outcomeClass">@(Model.Outcome == TradeOutcome.Manual ? "Zavřeno ručně" : Model.Outcome.ToString())</span>
                        @if (Model.Status == EntryStatus.Open)
                        {
                            <span class="badge badge-open">Open trade</span>
                        }
                        <span class="badge @(Model.FollowedTradingPlan ? "badge-plan" : "badge-muted")">
                            @(Model.FollowedTradingPlan ? "Plan followed" : "Plan not followed")
                        </span>
                    </div>
                </div>

                <div class="review-verdict @(Model.FollowedTradingPlan ? "good" : "warning")">
                    <span>Process</span>
                    <strong>@(Model.FollowedTradingPlan ? "Disciplined execution" : "Needs review")</strong>
                </div>

                <div class="metric-grid">
                    <div class="metric-cell">
                        <span>Entry</span>
                        <strong>@(entryLocal?.ToString("dd.MM.yyyy HH:mm") ?? "-")</strong>
                    </div>
                    <div class="metric-cell">
                        <span>Zisk / ztráta</span>
                        <strong>@(Model.ProfitLoss?.ToString("N2") ?? "Nezadáno")</strong>
                    </div>
                    <div class="metric-cell">
                        <span>Sezónnost seděla</span>
                        <strong>@(Model.SeasonalityAligned.HasValue ? (Model.SeasonalityAligned.Value ? "Ano" : "Ne") : "Nezjištěno")</strong>
                    </div>
                    @if (Model.Outcome is TradeOutcome.Breakeven or TradeOutcome.Manual)
                    {
                        <div class="metric-cell">
                            <span>Původní plán by skončil</span>
                            <strong>@(Model.PlannedOutcome switch { PlannedTradeOutcome.Win => "Zisk (TP)", PlannedTradeOutcome.Loss => "Ztráta (SL)", PlannedTradeOutcome.Breakeven => "BE", _ => "Nezjištěno" })</strong>
                        </div>
                    }
                    <div class="metric-cell">
                        <span>Risk</span>
                        <strong>@Model.RiskPercentage.ToString("0.##")%</strong>
                    </div>
                    <div class="metric-cell">
                        <span>Entry price</span>
                        <strong>@Model.EntryPrice.ToString("0.########")</strong>
                    </div>
                    <div class="metric-cell">
                        <span>Exit price</span>
                        <strong>@(Model.ExitPrice?.ToString("0.########") ?? "-")</strong>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Note))
                {
                    <div class="journal-note">
                        <span>Note</span>
                        <div class="preline">@Model.Note</div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.FeelingsBeforeEntry))
                {
                    <div class="journal-note">
                        <span>Feelings before entry</span>
                        <div class="preline">@Model.FeelingsBeforeEntry</div>
                    </div>
                }
            </section>

            <aside class="app-card screenshot-panel">
                <div class="panel-title">
                    <span>Screenshots</span>
                    <strong>@(Model.Images.Count + (Model.ImageData != null ? 1 : 0))</strong>
                </div>

                @if (Model.Images.Any() || Model.ImageData != null)
                {
                    <div class="image-gallery detail-gallery">
                        @foreach (var image in Model.Images.OrderBy(i => i.CreatedAt))
                        {
                            <button type="button" class="image-modal-trigger" data-image-src="@Url.Action("GalleryImage", "JournalEntries", new { id = image.Id })" data-image-title="@Model.Asset screenshot">
                                <img src="@Url.Action("GalleryImage", "JournalEntries", new { id = image.Id })"
                                     class="detail-image" />
                            </button>
                        }
                        @if (Model.ImageData != null)
                        {
                            <button type="button" class="image-modal-trigger" data-image-src="@Url.Action("Image", "JournalEntries", new { id = Model.Id })" data-image-title="@Model.Asset screenshot">
                                <img src="@Url.Action("Image", "JournalEntries", new { id = Model.Id })"
                                     class="detail-image" />
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-image detail-empty">
                        <span>No image</span>
                    </div>
                }
            </aside>
        </div>
    </div>
</div>

<partial name="_ImagePreviewModal" />

@section Scripts {
    <script src="~/js/journal-ui.js" asp-append-version="true"></script>
}
